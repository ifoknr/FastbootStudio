<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:props="clr-namespace:FastbootEnhance.Properties">

    <!-- The light palette: the same keys as Palette.Dark.xaml, in the same tones. The accent,
         amber and red are darker here so they keep their contrast on a light page. -->
    <SolidColorBrush x:Key="Bg" Color="#F8F7FB"/>
    <SolidColorBrush x:Key="Rail" Color="#F8F7FB"/>
    <SolidColorBrush x:Key="Well" Color="#F2F1F6"/>
    <SolidColorBrush x:Key="Surface" Color="#ECEBF0"/>
    <SolidColorBrush x:Key="Raised" Color="#E4E3E9"/>
    <SolidColorBrush x:Key="Hover" Color="#DBDAE1"/>
    <SolidColorBrush x:Key="Line" Color="#C6C6CE"/>
    <SolidColorBrush x:Key="Text" Color="#1B1B1F"/>
    <SolidColorBrush x:Key="Dim" Color="#45464F"/>
    <SolidColorBrush x:Key="Faint" Color="#6C6D76"/>
    <SolidColorBrush x:Key="Accent" Color="#3D5BA9"/>
    <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#DDE1F9"/>
    <SolidColorBrush x:Key="AccentLine" Color="#B9C3E8"/>
    <SolidColorBrush x:Key="Warn" Color="#7C5800"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#FFEFD0"/>
    <SolidColorBrush x:Key="WarnLine" Color="#E3C178"/>
    <SolidColorBrush x:Key="Danger" Color="#BA1A1A"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FFDAD6"/>
    <SolidColorBrush x:Key="DangerLine" Color="#F0ABA4"/>
    <SolidColorBrush x:Key="Ok" Color="#2A6B36"/>
    <SolidColorBrush x:Key="Thumb" Color="#C0C0C8"/>

    <!-- Scroll bar corners and other bits WPF draws in system colours. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#ECEBF0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#ECEBF0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#ECEBF0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#ECEBF0"/>

    <!-- IFOKNR, drawn in the Swamp Ninja lettering as a picture: no font file ships with the app. -->
    <BitmapImage x:Key="Signature" UriSource="pack://application:,,,/Assets/signature-light.png"/>
    <!-- The app name in the Prixma Bold Italic lettering, as a picture as well. -->
    <BitmapImage x:Key="AppName" UriSource="pack://application:,,,/Assets/appname-light.png"/>
</ResourceDictionary>
