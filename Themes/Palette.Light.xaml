<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:props="clr-namespace:FastbootEnhance.Properties">

    <!-- The light palette: frosted glass, the same keys as Palette.Dark.xaml. The accent, amber
         and red are darker here so they keep their contrast on white. -->
    <SolidColorBrush x:Key="Bg" Color="#EEF0F5"/>
    <SolidColorBrush x:Key="Rail" Color="#F3F5F9"/>
    <SolidColorBrush x:Key="Well" Color="#F7F8FB"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Raised" Color="#E6E9F0"/>
    <SolidColorBrush x:Key="Hover" Color="#DCE0E9"/>
    <SolidColorBrush x:Key="Line" Color="#D3D8E2"/>
    <SolidColorBrush x:Key="Text" Color="#151821"/>
    <SolidColorBrush x:Key="Dim" Color="#5A6070"/>
    <SolidColorBrush x:Key="Faint" Color="#8C92A3"/>
    <SolidColorBrush x:Key="Accent" Color="#2F6BFF"/>
    <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#DEE7FF"/>
    <SolidColorBrush x:Key="AccentLine" Color="#A9C0FF"/>
    <SolidColorBrush x:Key="Warn" Color="#B45309"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#FFF1D6"/>
    <SolidColorBrush x:Key="WarnLine" Color="#F3C77A"/>
    <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FFE1E1"/>
    <SolidColorBrush x:Key="DangerLine" Color="#F3A9A9"/>
    <SolidColorBrush x:Key="Ok" Color="#16A34A"/>
    <SolidColorBrush x:Key="OkSoft" Color="#DCF5E5"/>
    <SolidColorBrush x:Key="OkLine" Color="#9ED9B4"/>
    <SolidColorBrush x:Key="Sel" Color="#E3E8F3"/>
    <SolidColorBrush x:Key="OnSel" Color="#151821"/>
    <SolidColorBrush x:Key="Thumb" Color="#B9BEC9"/>

    <!-- The cards and bars: solid white on a pale grey page, like the dark theme's solid charcoal. -->
    <SolidColorBrush x:Key="Glass" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Glass2" Color="#F2F4F8"/>
    <SolidColorBrush x:Key="GlassLine" Color="#DDE1E9"/>
    <SolidColorBrush x:Key="GlassLine2" Color="#CDD3DE"/>
    <SolidColorBrush x:Key="SkyBrush" Color="#EEF0F5"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A80FF" Offset="0"/>
        <GradientStop Color="#245BE0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Scroll bar corners and other bits WPF draws in system colours. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#EEF0F5"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#EEF0F5"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#EEF0F5"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#EEF0F5"/>

    <!-- The app icon: frosted glass with a blue bolt (tools/icon/glass-light.svg). -->
    <BitmapImage x:Key="AppIcon" UriSource="pack://application:,,,/Assets/icon-light.png"/>
    <!-- IFOKNR, drawn in the Swamp Ninja lettering as a picture: no font file ships with the app. -->
    <BitmapImage x:Key="Signature" UriSource="pack://application:,,,/Assets/signature-light.png"/>
    <!-- The app name in the Prixma Bold Italic lettering, as a picture as well. -->
    <BitmapImage x:Key="AppName" UriSource="pack://application:,,,/Assets/appname-light.png"/>
</ResourceDictionary>
