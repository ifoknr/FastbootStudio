<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:props="clr-namespace:FastbootEnhance.Properties"
                    xmlns:local="clr-namespace:FastbootEnhance">

    <!-- Styles and shared resources. The colours come from Palette.Dark.xaml or
         Palette.Light.xaml, loaded before this file (Theme.cs). -->
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Navigation icons, drawn as strokes on a 24 unit grid. -->
    <Geometry x:Key="IconDevice">M7,2 H17 A2,2 0 0 1 19,4 V20 A2,2 0 0 1 17,22 H7 A2,2 0 0 1 5,20 V4 A2,2 0 0 1 7,2 Z M10,18 H14</Geometry>
    <Geometry x:Key="IconPhoneInfo">M7,2 H17 A2,2 0 0 1 19,4 V20 A2,2 0 0 1 17,22 H7 A2,2 0 0 1 5,20 V4 A2,2 0 0 1 7,2 Z M9,7 H15 M9,11 H15 M9,15 H12.5</Geometry>
    <Geometry x:Key="IconFlash">M13,2 L4,14 H11 L10,22 L19,10 H12 Z</Geometry>
    <Geometry x:Key="IconPayload">M21,8 L12,3 L3,8 V16 L12,21 L21,16 Z M3,8 L12,13 L21,8 M12,13 V21</Geometry>
    <Geometry x:Key="IconLogs">M4,5 H20 M4,12 H15 M4,19 H11</Geometry>
    <Geometry x:Key="IconTerminal">M5,4 H19 A2,2 0 0 1 21,6 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 V6 A2,2 0 0 1 5,4 Z M7,9 L10,12 L7,15 M12.5,15 H17</Geometry>
    <!-- Interface font: Roboto for Latin text, Noto Kufi Arabic for Arabic. WPF falls back per
         character along this list, so mixed text picks the right face for each script; Segoe UI
         and then Windows' own fallback cover Chinese, Japanese and Korean. Both fonts are
         embedded (Fonts/, SIL OFL 1.1). -->
    <FontFamily x:Key="UiFont">/Fonts/#Roboto, /Fonts/#Noto Kufi Arabic, Segoe UI</FontFamily>

    <Geometry x:Key="IconLayers">M12,3 L21,7.5 L12,12 L3,7.5 Z M3,12 L12,16.5 L21,12 M3,16.5 L12,21 L21,16.5</Geometry>
    <Geometry x:Key="IconBricks">M3.5,4 H20.5 V20 H3.5 Z M3.5,9.3 H20.5 M3.5,14.7 H20.5 M10,4 V9.3 M14.5,9.3 V14.7 M8,14.7 V20</Geometry>
    <!-- A phone with a download arrow: Samsung firmware, flashed from Download mode. -->
    <Geometry x:Key="IconSamsung">M7,2 H17 A2,2 0 0 1 19,4 V20 A2,2 0 0 1 17,22 H7 A2,2 0 0 1 5,20 V4 A2,2 0 0 1 7,2 Z M12,6.5 V13.5 M9,10.5 L12,13.5 L15,10.5 M10,18 H14</Geometry>
    <Geometry x:Key="IconBackup">M3,5 H21 V9 H3 Z M5,9 V19 H19 V9 M10,13 H14</Geometry>
    <Geometry x:Key="IconFolder">M3,6 A1,1 0 0 1 4,5 H9 L11,7 H20 A1,1 0 0 1 21,8 V18 A1,1 0 0 1 20,19 H4 A1,1 0 0 1 3,18 Z</Geometry>
    <Geometry x:Key="IconFile">M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19</Geometry>
    <Geometry x:Key="IconGitHub">M12,1.5 A10.5,10.5 0 0 0 8.7,22 C9.2,22.1 9.4,21.8 9.4,21.5 V19.6 C6.5,20.2 5.9,18.3 5.9,18.3 C5.4,17.1 4.7,16.8 4.7,16.8 C3.8,16.1 4.8,16.2 4.8,16.2 C5.8,16.3 6.4,17.3 6.4,17.3 C7.3,18.9 8.9,18.4 9.5,18.1 C9.6,17.5 9.9,17 10.2,16.8 C7.8,16.5 5.4,15.6 5.4,11.6 C5.4,10.5 5.8,9.6 6.4,8.9 C6.3,8.6 6,7.6 6.5,6.2 C6.5,6.2 7.4,5.9 9.4,7.3 A10,10 0 0 1 14.6,7.3 C16.6,5.9 17.5,6.2 17.5,6.2 C18,7.6 17.7,8.6 17.6,8.9 C18.2,9.6 18.6,10.5 18.6,11.6 C18.6,15.6 16.2,16.5 13.8,16.8 C14.2,17.1 14.6,17.8 14.6,18.8 V21.5 C14.6,21.8 14.8,22.1 15.3,22 A10.5,10.5 0 0 0 12,1.5 Z</Geometry>
    <Geometry x:Key="IconRoot">M8,3.5 A4.5,4.5 0 1 1 7.99,3.5 Z M11.2,11.2 L20,20 M17.5,17.5 L20,15 M14.8,14.8 L17,12.6</Geometry>
    <Geometry x:Key="IconSettings">M4,7 H13 M17,7 H20 M4,17 H7 M11,17 H20 M15,4.5 V9.5 M9,14.5 V19.5</Geometry>
    <Geometry x:Key="IconSend">M21,4 L3,11 L9,13.3 L19,6.5 L11,14.5 L11.5,20 L14.5,16.5 L18.5,19.5 Z</Geometry>
    <Geometry x:Key="IconGroup">M9,11 A3.2,3.2 0 1 1 8.99,11 Z M2.5,20 C3,16.5 5.5,15 9,15 C12.5,15 15,16.5 15.5,20 M16,5.2 A3,3 0 0 1 16,11 M18,14.8 C20,15.4 21.2,17 21.5,19.5</Geometry>
    <Geometry x:Key="IconGlobe">M12,2.5 A9.5,9.5 0 1 1 11.99,2.5 Z M2.5,12 H21.5 M12,2.5 C9,6 9,18 12,21.5 M12,2.5 C15,6 15,18 12,21.5</Geometry>
    <Geometry x:Key="IconAbout">M12,2 A10,10 0 1 1 11.99,2 Z M12,11 V17 M12,7 V8</Geometry>

    <!-- Text -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Dim}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Note" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Dim}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <!-- Surfaces -->
    <!-- Every card is a sheet of glass: translucent over the sky gradient, with a hairline edge
         and the same 16 px corners everywhere. -->
    <!-- The scale since the density pass: cards 14 px corners with 16 x 14 padding and 12 px between
         them; controls 10 px corners; small tiles and tabs 7 to 8 px. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Glass}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="WarnCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource WarnSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarnLine}"/>
    </Style>

    <Style x:Key="PageHeader" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="24,14,24,8"/>
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Glass2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLine2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- 11 px, about half a chip's height: WPF draws a radius bigger than half the height as an oval. -->
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Keyboard focus: one ring for every control, drawn just outside it in the accent. It shows
         for the keyboard only (Tab, arrows), never after a mouse click. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="13" BorderBrush="{StaticResource Accent}" BorderThickness="2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The same ring inside the control's own edge, for rows and tabs that sit edge to edge. -->
    <Style x:Key="FocusRingInside">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="1" CornerRadius="7" BorderBrush="{StaticResource Accent}" BorderThickness="2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons: one template; variants only change colours. -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource OnSel}"/>
        <Setter Property="Background" Value="{StaticResource Glass2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLine2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- The shape, a tint laid over it for hover and pressed, and the label on top. The
                     label is never made see-through for a state: that softened its letters. -->
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"/>
                        <Border x:Name="tint" CornerRadius="10" Background="{StaticResource HoverTint}" Visibility="Collapsed"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="tint" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="tint" Property="Background" Value="{StaticResource PressTint}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentLine}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <!-- The blue glow comes from an empty shape under the button. As an effect on the button
             itself it turned the whole button, label included, into a picture: soft letters and
             edges, worse at 125% and 150%. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="glow" CornerRadius="10" Margin="8,8,8,1" Background="{StaticResource AccentFill}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#2F6BFF"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"/>
                        <Border x:Name="tint" CornerRadius="10" Background="{StaticResource HoverTint}" Visibility="Collapsed"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="tint" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="tint" Property="Background" Value="{StaticResource PressTint}"/>
                            <Setter TargetName="glow" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter TargetName="glow" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerLine}"/>
        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Warn}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Warn}"/>
        <Setter Property="Foreground" Value="{StaticResource WarnSoft}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLine2}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <!-- A button label that wraps onto a second line instead of being cut (long labels, Arabic). Used
         with Padding="12,7" so two lines have room. -->
    <DataTemplate x:Key="WrapLabel">
        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
    </DataTemplate>

    <!-- A square button holding one icon (the About page's links). -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Background" Value="{StaticResource Glass2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLine2}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <!-- A template, not a Content element: one Path set as Content is shared, so only the last button showed its icon. -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" FlowDirection="LeftToRight"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Content" Value=" "/>
    </Style>

    <!-- The question mark in the corner of each page: opens that page's help at the side. -->
    <!-- A row on About: an icon tile, two lines of text, a chevron; the whole row is the link. -->
    <Style x:Key="LinkRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="12" Padding="8,7">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="10" Background="{StaticResource Glass2}" BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Margin="0,0,12,0">
                                <Path Data="{TemplateBinding Tag}" Stroke="{StaticResource OnSel}" StrokeThickness="1.7" Stretch="Uniform"
                                      Width="18" Height="18" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" FlowDirection="LeftToRight"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Right" Text="›" FontSize="20" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="8,0,4,0"
                                       RenderTransformOrigin="0.5,0.5"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Raised}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Raised}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HelpButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="10" Background="{StaticResource Glass2}"
                            BorderBrush="{StaticResource GlassLine2}" BorderThickness="1" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Well}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLine2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                            <!-- Tag doubles as a placeholder, shown while the box is empty. -->
                            <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Padding="2,0"
                                       Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Dim}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="5" VerticalAlignment="Top" Margin="0,1,0,0"
                                Background="{StaticResource Bg}" BorderBrush="{StaticResource GlassLine2}" BorderThickness="1" SnapsToDevicePixels="True">
                            <Path x:Name="mark" FlowDirection="LeftToRight" Data="M3.5,8.5 L7,12 L13,4.5" Stroke="{StaticResource AccentInk}"
                                  StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource AccentFill}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentFill}"/>
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A choice of a few options, drawn as a row of pills; the chosen one is in the accent. -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Dim}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,3"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" CornerRadius="10" Background="{StaticResource Glass2}" BorderBrush="{StaticResource GlassLine2}"
                            BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Dim}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentFill}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentFill}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource Glass2}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                        <!-- "Working, no percentage yet": a short bar that runs along the track. -->
                        <Border x:Name="runner" Width="90" CornerRadius="3" HorizontalAlignment="Left" Visibility="Collapsed"
                                Background="{TemplateBinding Foreground}">
                            <Border.RenderTransform>
                                <TranslateTransform X="-90"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Only when Windows' own "animate controls" setting is on; otherwise the dimmed bar below stays as the sign. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="runner" Property="Visibility" Value="Visible"/>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="running">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="runner"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-90" To="900" Duration="0:0:1.8"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="running"/>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <!-- With no animation part the indicator fills the track; dim it so it reads as "working". -->
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scroll bars: thin, dark, no arrow buttons. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="4" Background="{StaticResource Thumb}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" Margin="2"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" Margin="2"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The scrolling part of every list. Windows' own version draws two white hairlines in the
         corner where the two scroll bars meet (a stray bracket on charcoal); here that corner is
         empty. The header row keeps its own hidden scroller, which follows the rows sideways. -->
    <Style x:Key="{x:Static GridView.GridViewScrollViewerStyleKey}" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <ScrollViewer DockPanel.Dock="Top" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                                <GridViewHeaderRowPresenter Margin="2,0,2,0"
                                    Columns="{Binding Path=TemplatedParent.View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderContainerStyle="{Binding Path=TemplatedParent.View.ColumnHeaderContainerStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderTemplate="{Binding Path=TemplatedParent.View.ColumnHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                    AllowsColumnReorder="{Binding Path=TemplatedParent.View.AllowsColumnReorder, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderToolTip="{Binding Path=TemplatedParent.View.ColumnHeaderToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" KeyboardNavigation.DirectionalNavigation="Local"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        </DockPanel>
                        <!-- Only while there are more rows than fit. -->
                        <Border Height="18" VerticalAlignment="Bottom" IsHitTestVisible="False" Background="{StaticResource GlassFade}"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Cursor="Arrow"
                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Cursor="Arrow"
                                   Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lists. Every ListView here has a GridView, so the template keeps GridView's scroll viewer and
         its header row. The theme's own template turns the list white while it is disabled (during an
         extraction, for one); this one only dims it. -->
    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- Digits of one width, so sizes and counts line up down a column and do not shift as they change. -->
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ScrollViewer Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}"
                                      Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                        </Trigger>
                        <Trigger Property="IsGrouping" Value="True">
                            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border Background="Transparent" BorderBrush="{StaticResource GlassLine}" BorderThickness="0,0,0,1">
                            <ContentPresenter Margin="10,6" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInside}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource GlassLine}"
                            BorderThickness="0,0,0,1" Padding="4,5" SnapsToDevicePixels="True">
                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                              Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Glass}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLine}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inner tabs read as a segmented control. -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- The control itself takes no focus mark: Windows' dotted rectangle around the whole area showed in the light theme. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource GlassLine}" BorderThickness="1"
                                CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,10" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The hand cursor sits on the header border, not on the TabItem: a Cursor set on the
         TabItem also reaches the whole page it shows, which then looked clickable everywhere. -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Dim}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInside}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- 7 px: the strip's 10 px corner less its 3 px padding, so the two curves run parallel. -->
                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="12,5" Margin="0,0,2,0" Cursor="Hand">
                        <ContentPresenter x:Name="header" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverTint}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Glass2}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <!-- On the tab's own label only. Set on the tab, the weight was inherited by the
                                 whole page the tab shows: every line of it came out semi-bold. -->
                            <Setter TargetName="header" Property="TextElement.FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The main window's tab control becomes the side navigation rail. Pages come in groups
         (NavGroup headings between them); Settings and About sit at the foot (local:Rail.Foot).
         The content column carries the device bar on top (Rail.TopBar) and the status bar
         below (Rail.BottomBar); both are set in MainWindow.xaml so their parts have names. -->
    <Style x:Key="NavItem" TargetType="TabItem">
        <Setter Property="DockPanel.Dock" Value="Top"/>
        <Setter Property="Foreground" Value="{StaticResource Dim}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInside}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Height="32" Margin="0,1" Cursor="Hand" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                            <Path x:Name="icon" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="header" ContentSource="Header" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Glass}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Glass2}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GlassLine2}"/>
                            <Setter TargetName="icon" Property="Stroke" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <!-- On the label only: set on the item, the page it shows inherited it (see the inner tabs). -->
                            <Setter TargetName="header" Property="TextElement.FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A heading between groups of pages: a label, nothing to click or select. -->
    <Style x:Key="NavGroup" TargetType="TabItem">
        <Setter Property="DockPanel.Dock" Value="Top"/>
        <Setter Property="IsEnabled" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <TextBlock Text="{TemplateBinding Header}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Faint}"
                               Margin="12,10,12,4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A hairline above the pages at the foot of the rail. -->
    <Style x:Key="NavRule" TargetType="TabItem" BasedOn="{StaticResource NavGroup}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Height="1" Background="{StaticResource GlassLine}" Margin="4,8,4,8"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A drop-down list (the partition picker when flashing a Samsung file): the box of a text
         field with a chevron, and a list drawn like the menus. Windows' own grey box stood out. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="10,6" Cursor="Hand">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{StaticResource Well}" BorderBrush="{StaticResource GlassLine2}" BorderThickness="1"
                                            CornerRadius="10" SnapsToDevicePixels="True">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M0,0 L4,4 L8,0"
                                              Stroke="{StaticResource Dim}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Dim}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="12,6,30,6" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,0,0"
                                    Background="{StaticResource Raised}" BorderBrush="{StaticResource GlassLine2}" BorderThickness="1"
                                    CornerRadius="10" Padding="4" SnapsToDevicePixels="True" RenderOptions.ClearTypeHint="Enabled"
                                    TextElement.Foreground="{StaticResource Text}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus (the device bar's restart choices): glass, like the rest. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- The shadow comes from an empty sheet behind the menu, so the items' text is not blurred by it. -->
                    <Grid Margin="8" SnapsToDevicePixels="True">
                        <Border Background="{StaticResource Raised}" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
                            </Border.Effect>
                        </Border>
                        <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource GlassLine2}" BorderThickness="1" CornerRadius="12" Padding="6"
                                RenderOptions.ClearTypeHint="Enabled">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,7" MinWidth="180" Cursor="Hand">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tool tips in the theme's own colours (Windows' default is a white box, glaring on charcoal). -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource GlassLine2}" BorderThickness="1" CornerRadius="8"
                            Padding="10,6" SnapsToDevicePixels="True" RenderOptions.ClearTypeHint="Enabled">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavRail" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="212"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource GlassLine}" BorderThickness="0,0,1,0">
                            <DockPanel Margin="12,14,12,12">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,14">
                                    <Image FlowDirection="LeftToRight" Source="{StaticResource AppIcon}" Width="32" Height="32"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Image Source="{StaticResource AppName}" Height="13" HorizontalAlignment="Left" Margin="0,0,0,3" FlowDirection="LeftToRight"
                                               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Fastboot Studio"/>
                                        <TextBlock Text="{x:Static local:MainWindow.versionLabel}" FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Faint}"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Shown by UpdateUI when a newer version is out; opens the update dialog. -->
                                <Button x:Name="update_badge" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,8,0,0"
                                        Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}"
                                                    BorderThickness="1" CornerRadius="10" Padding="12,8" SnapsToDevicePixels="True">
                                                <DockPanel>
                                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{StaticResource Accent}"
                                                             Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                    <ContentPresenter TextElement.Foreground="{StaticResource Accent}"
                                                                      TextElement.FontWeight="SemiBold" TextElement.FontSize="12"
                                                                      VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <!-- Pages dock at the top; Settings and About (DockPanel.Dock="Bottom" in MainWindow.xaml) at the foot. -->
                                <DockPanel IsItemsHost="True" LastChildFill="False" KeyboardNavigation.TabIndex="1"/>
                            </DockPanel>
                        </Border>
                        <DockPanel Grid.Column="1">
                            <ContentPresenter DockPanel.Dock="Top" Content="{Binding Path=(local:Rail.TopBar), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding Path=(local:Rail.BottomBar), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The top bar's phone chips and the status bar's text. -->
    <Style x:Key="BarChip" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- A page with nothing open yet: a dashed frame, a big icon, "drop a file here" and the formats. -->
    <Style x:Key="EmptyFrame" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Glass}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="32,28"/>
    </Style>
    <Style x:Key="EmptyIcon" TargetType="Border">
        <Setter Property="Width" Value="76"/>
        <Setter Property="Height" Value="76"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Background" Value="{StaticResource Glass2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLine2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
    <Style x:Key="FormatChip" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="3,3"/>
        <Setter Property="TextElement.FontSize" Value="11"/>
        <Setter Property="TextElement.FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Dim}"/>
    </Style>

    <!-- One step of a guided page (Root): a numbered circle, the title, the body shown when it is the current step. -->
    <Style x:Key="StepNo" TargetType="Border">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Background" Value="{StaticResource Glass2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassLine2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StepCard" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border x:Name="bd" Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="18,13">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"/>
                            </ToggleButton>
                            <Border x:Name="body" Padding="18,0,18,16" Visibility="Collapsed">
                                <ContentPresenter/>
                            </Border>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GlassLine2}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window frame. The app draws its own title bar so every window looks the same on every
         version of Windows; ThemedWindow.Attach wires the caption buttons. -->
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Dim}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C42B1C"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChromeGlyph" TargetType="Path">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Style>

    <Style x:Key="ThemedWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource SkyBrush}"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0"
                              CornerRadius="0" UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border x:Name="frame" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource GlassLine2}" BorderThickness="1" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Glass}">
                                <TextBlock x:Name="caption" Text="{TemplateBinding Title}" Margin="14,0,150,0"
                                           VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Dim}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="minimize" Style="{StaticResource ChromeButton}"
                                            Command="{x:Static SystemCommands.MinimizeWindowCommand}" ToolTip="{x:Static props:Resources.chrome_minimize}"
                                            AutomationProperties.Name="{x:Static props:Resources.chrome_minimize}">
                                        <Path Style="{StaticResource ChromeGlyph}" Data="M0,5.5 H10"/>
                                    </Button>
                                    <Button x:Name="maximize" Style="{StaticResource ChromeButton}"
                                            Command="{x:Static SystemCommands.MaximizeWindowCommand}" ToolTip="{x:Static props:Resources.chrome_maximize}"
                                            AutomationProperties.Name="{x:Static props:Resources.chrome_maximize}">
                                        <Path Style="{StaticResource ChromeGlyph}" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"/>
                                    </Button>
                                    <Button x:Name="restore" Style="{StaticResource ChromeButton}" Visibility="Collapsed"
                                            Command="{x:Static SystemCommands.RestoreWindowCommand}" ToolTip="{x:Static props:Resources.chrome_restore}"
                                            AutomationProperties.Name="{x:Static props:Resources.chrome_restore}">
                                        <Path Style="{StaticResource ChromeGlyph}" Data="M2.5,2.5 V0.5 H9.5 V7.5 H7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z"/>
                                    </Button>
                                    <Button x:Name="close" Style="{StaticResource ChromeCloseButton}"
                                            Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="{x:Static props:Resources.chrome_close}"
                                            AutomationProperties.Name="{x:Static props:Resources.chrome_close}">
                                        <Path Style="{StaticResource ChromeGlyph}" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <AdornerDecorator>
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="maximize" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="restore" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="frame" Property="BorderThickness" Value="0"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="minimize" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="maximize" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="restore" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="caption" Property="Foreground" Value="{StaticResource Faint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
