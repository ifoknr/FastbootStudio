<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:props="clr-namespace:FastbootEnhance.Properties">

    <!-- The dark palette. Palette.Light.xaml has the same keys; Theme.cs loads one of the two
         before Styles.xaml, whose styles take their colours from whichever is loaded. -->
    <!-- Material 3 Expressive, the same as Fastboot Studio Mobile and the Companion WebUI: muted
         grey surfaces, a light periwinkle accent with dark text on it, and a slate tonal fill
         (AccentSoft) for selections and buttons. Amber and red stay for warnings and destructive
         actions. -->
    <SolidColorBrush x:Key="Bg" Color="#2A2A2C"/>
    <SolidColorBrush x:Key="Rail" Color="#2A2A2C"/>
    <SolidColorBrush x:Key="Well" Color="#2F2F31"/>
    <SolidColorBrush x:Key="Surface" Color="#353537"/>
    <SolidColorBrush x:Key="Raised" Color="#3D3D40"/>
    <SolidColorBrush x:Key="Hover" Color="#47474B"/>
    <SolidColorBrush x:Key="Line" Color="#4A4A4F"/>
    <SolidColorBrush x:Key="Text" Color="#E5E3E8"/>
    <SolidColorBrush x:Key="Dim" Color="#C4C4CB"/>
    <SolidColorBrush x:Key="Faint" Color="#8F8F95"/>
    <SolidColorBrush x:Key="Accent" Color="#A8C4FF"/>
    <SolidColorBrush x:Key="AccentInk" Color="#152C5E"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#3F455A"/>
    <SolidColorBrush x:Key="AccentLine" Color="#56607E"/>
    <SolidColorBrush x:Key="Warn" Color="#F2C46D"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#4A3A2C"/>
    <SolidColorBrush x:Key="WarnLine" Color="#6D5530"/>
    <SolidColorBrush x:Key="Danger" Color="#FFB4AB"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#6E2A27"/>
    <SolidColorBrush x:Key="DangerLine" Color="#8C3A3A"/>
    <SolidColorBrush x:Key="Ok" Color="#94D6A0"/>
    <SolidColorBrush x:Key="Thumb" Color="#5A5A60"/>

    <!-- Default templates fill the corner where two scroll bars meet with the system control
         colour, which is near-white; this keeps it dark. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#353537"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#353537"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#353537"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#353537"/>


    <!-- IFOKNR, drawn in the Swamp Ninja lettering as a picture: no font file ships with the app. -->
    <BitmapImage x:Key="Signature" UriSource="pack://application:,,,/Assets/signature-dark.png"/>
    <!-- The app name in the Prixma Bold Italic lettering, as a picture as well. -->
    <BitmapImage x:Key="AppName" UriSource="pack://application:,,,/Assets/appname-dark.png"/>
</ResourceDictionary>
