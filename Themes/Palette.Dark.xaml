<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:props="clr-namespace:FastbootEnhance.Properties">

    <!-- The dark palette: grey glass. Palette.Light.xaml has the same keys; Theme.cs loads one
         of the two before Styles.xaml, whose styles take their colours from whichever is loaded.
         Surfaces are translucent so the sky gradient behind them shows through, which is what
         reads as glass; lines are white at low alpha. -->
    <!-- One accent; amber and red are reserved for warnings and destructive actions. -->
    <SolidColorBrush x:Key="Bg" Color="#121214"/>
    <SolidColorBrush x:Key="Rail" Color="#161619"/>
    <SolidColorBrush x:Key="Well" Color="#101012"/>
    <SolidColorBrush x:Key="Surface" Color="#1B1B1F"/>
    <SolidColorBrush x:Key="Raised" Color="#26262B"/>
    <SolidColorBrush x:Key="Hover" Color="#303036"/>
    <SolidColorBrush x:Key="Line" Color="#2C2C32"/>
    <SolidColorBrush x:Key="Text" Color="#ECECF1"/>
    <SolidColorBrush x:Key="Dim" Color="#A2A2AD"/>
    <!-- Faint was #6D6D78 (3.4:1 on a card); small labels in it were hard to read. Now 5.3:1 on a card, 4.6:1 on a raised tile. -->
    <SolidColorBrush x:Key="Faint" Color="#8E8E9A"/>
    <SolidColorBrush x:Key="Accent" Color="#7AA2FF"/>
    <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF"/>
    <!-- The accent as a background under white text (a chosen option, a ticked box): deep enough for 4.5:1.
         "Accent" itself stays the light blue, for text, icons and lines on charcoal. -->
    <SolidColorBrush x:Key="AccentFill" Color="#3F6FE8"/>
    <!-- Laid over a control while the mouse is on it, and while it is pressed. -->
    <SolidColorBrush x:Key="HoverTint" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="PressTint" Color="#33000000"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1E2840"/>
    <SolidColorBrush x:Key="AccentLine" Color="#34497A"/>
    <SolidColorBrush x:Key="Warn" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#3A2E12"/>
    <SolidColorBrush x:Key="WarnLine" Color="#6B5320"/>
    <SolidColorBrush x:Key="Danger" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#3E1A1C"/>
    <SolidColorBrush x:Key="DangerLine" Color="#7A2E33"/>
    <SolidColorBrush x:Key="Ok" Color="#4ADE80"/>
    <SolidColorBrush x:Key="OkSoft" Color="#15301F"/>
    <SolidColorBrush x:Key="OkLine" Color="#1F5A35"/>
    <SolidColorBrush x:Key="Sel" Color="#26262B"/>
    <SolidColorBrush x:Key="OnSel" Color="#ECECF1"/>
    <SolidColorBrush x:Key="Thumb" Color="#3E3E46"/>

    <!-- The cards and bars: solid charcoal one step above the page (IFOKNR chose solid over see-through, 9 Nov). -->
    <SolidColorBrush x:Key="Glass" Color="#1B1B1F"/>
    <SolidColorBrush x:Key="Glass2" Color="#26262B"/>
    <SolidColorBrush x:Key="GlassLine" Color="#2C2C32"/>
    <SolidColorBrush x:Key="GlassLine2" Color="#3A3A42"/>
    <!-- Behind everything: a diagonal gradient, blue-tinted at the top start. A plain gradient, because
         a DrawingBrush draws black under software rendering, which is the app's default. -->
    <SolidColorBrush x:Key="SkyBrush" Color="#121214"/>
    <!-- The accent button: a slight gradient so it reads as a glass pill, not a flat block. -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
        <!-- Was #7AA2FF to #4A74E6: white on its top was 2.5:1. Now 4.5:1 at the top, 5.5:1 at the bottom. -->
        <GradientStop Color="#3F6FE8" Offset="0"/>
        <GradientStop Color="#3560D6" Offset="1"/>
    </LinearGradientBrush>

    <!-- Default templates fill the corner where two scroll bars meet with the system control
         colour, which is near-white; this keeps it dark. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1B1B1F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#1B1B1F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#1B1B1F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#1B1B1F"/>

    <!-- The app icon: grey glass with the bolt on a screen (tools/icon/glass-dark.svg). -->
    <BitmapImage x:Key="AppIcon" UriSource="pack://application:,,,/Assets/icon-themed.png"/>
    <!-- IFOKNR, drawn in the Swamp Ninja lettering as a picture: no font file ships with the app. -->
    <BitmapImage x:Key="Signature" UriSource="pack://application:,,,/Assets/signature-dark.png"/>
    <!-- The app name in the Prixma Bold Italic lettering, as a picture as well. -->
    <BitmapImage x:Key="AppName" UriSource="pack://application:,,,/Assets/appname-dark.png"/>
</ResourceDictionary>
