<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:props="clr-namespace:FastbootEnhance.Properties">

    <!-- The dark palette: grey glass. Palette.Light.xaml has the same keys; Theme.cs loads one
         of the two before Styles.xaml, whose styles take their colours from whichever is loaded.
         Surfaces are translucent so the sky gradient behind them shows through, which is what
         reads as glass; lines are white at low alpha. -->
    <!-- One accent; amber and red are reserved for warnings and destructive actions. -->
    <SolidColorBrush x:Key="Bg" Color="#0B0B0F"/>
    <SolidColorBrush x:Key="Rail" Color="#0F0F14"/>
    <SolidColorBrush x:Key="Well" Color="#0D0D12"/>
    <SolidColorBrush x:Key="Surface" Color="#17171D"/>
    <SolidColorBrush x:Key="Raised" Color="#212129"/>
    <SolidColorBrush x:Key="Hover" Color="#2B2B35"/>
    <SolidColorBrush x:Key="Line" Color="#2A2A33"/>
    <SolidColorBrush x:Key="Text" Color="#F1F1F4"/>
    <SolidColorBrush x:Key="Dim" Color="#A6A6B0"/>
    <SolidColorBrush x:Key="Faint" Color="#6E6E78"/>
    <SolidColorBrush x:Key="Accent" Color="#5B8CFF"/>
    <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1A2746"/>
    <SolidColorBrush x:Key="AccentLine" Color="#2F4A8F"/>
    <SolidColorBrush x:Key="Warn" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#3A2E12"/>
    <SolidColorBrush x:Key="WarnLine" Color="#6B5320"/>
    <SolidColorBrush x:Key="Danger" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#3E1A1C"/>
    <SolidColorBrush x:Key="DangerLine" Color="#7A2E33"/>
    <SolidColorBrush x:Key="Ok" Color="#4ADE80"/>
    <SolidColorBrush x:Key="OkSoft" Color="#15301F"/>
    <SolidColorBrush x:Key="OkLine" Color="#1F5A35"/>
    <SolidColorBrush x:Key="Sel" Color="#23232E"/>
    <SolidColorBrush x:Key="OnSel" Color="#F1F1F4"/>
    <SolidColorBrush x:Key="Thumb" Color="#45454F"/>

    <!-- Glass: the cards and bars, see-through enough for the sky to tint them. -->
    <SolidColorBrush x:Key="Glass" Color="#0BFFFFFF"/>
    <SolidColorBrush x:Key="Glass2" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="GlassLine" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="GlassLine2" Color="#26FFFFFF"/>
    <!-- Behind everything: near-black with a blue glow at the top start and a grey one at the bottom end. -->
    <DrawingBrush x:Key="SkyBrush" Stretch="Fill" Viewbox="0,0,1,1" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#0B0B0F"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.12,0" GradientOrigin="0.12,0" RadiusX="0.7" RadiusY="0.55">
                            <GradientStop Color="#2E5B8CFF" Offset="0"/>
                            <GradientStop Color="#005B8CFF" Offset="1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.92,1" GradientOrigin="0.92,1" RadiusX="0.55" RadiusY="0.5">
                            <GradientStop Color="#227882A0" Offset="0"/>
                            <GradientStop Color="#007882A0" Offset="1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- The accent button: a slight gradient so it reads as a glass pill, not a flat block. -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6A98FF" Offset="0"/>
        <GradientStop Color="#3F6FE6" Offset="1"/>
    </LinearGradientBrush>

    <!-- Default templates fill the corner where two scroll bars meet with the system control
         colour, which is near-white; this keeps it dark. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#17171D"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#17171D"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#17171D"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#17171D"/>

    <!-- The app icon: grey glass with the bolt on a screen (tools/icon/glass-dark.svg). -->
    <BitmapImage x:Key="AppIcon" UriSource="pack://application:,,,/Assets/icon-themed.png"/>
    <!-- IFOKNR, drawn in the Swamp Ninja lettering as a picture: no font file ships with the app. -->
    <BitmapImage x:Key="Signature" UriSource="pack://application:,,,/Assets/signature-dark.png"/>
    <!-- The app name in the Prixma Bold Italic lettering, as a picture as well. -->
    <BitmapImage x:Key="AppName" UriSource="pack://application:,,,/Assets/appname-dark.png"/>
</ResourceDictionary>
