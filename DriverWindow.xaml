<Window x:Class="FastbootEnhance.DriverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:FastbootEnhance.Properties"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="596" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <!-- Samsung's USB driver: download from Samsung, check Samsung signed it, run its installer. -->
    <Border Margin="18" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
            BorderThickness="1" CornerRadius="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="strip" Height="0" VerticalAlignment="Top" CornerRadius="27,27,0,0" Background="{StaticResource Accent}"/>

            <DockPanel x:Name="header" Margin="22,20,22,0" Background="Transparent">
                <Border x:Name="badge" DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" BorderThickness="1"
                        Margin="0,0,14,0" VerticalAlignment="Top"
                        Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}">
                    <Path FlowDirection="LeftToRight" x:Name="glyph" Width="18" Height="18" Stretch="Uniform" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{StaticResource Accent}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="heading" Style="{StaticResource CardTitle}" Margin="0" FontSize="15" TextWrapping="Wrap"/>
                    <TextBlock x:Name="subheading" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="70,12,22,0">
                <ProgressBar x:Name="progress" Height="6" Margin="0,4,0,6" Visibility="Collapsed" Maximum="100"/>
                <TextBlock x:Name="message" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"/>
            </StackPanel>

            <Border Grid.Row="2" Margin="0,18,0,0" Padding="22,14" Background="{StaticResource Bg}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,27,27">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="secondary" MinWidth="96" Margin="0,0,10,0"/>
                    <Button x:Name="primary" MinWidth="120" Style="{StaticResource AccentButton}" IsDefault="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
