                                <TextBlock FontWeight="SemiBold" Text="{x:Static props:Resources.rendering}"/>
                                <WrapPanel x:Name="rendering_buttons" Margin="0,8,0,0"/>
                                <TextBlock Style="{StaticResource Note}" FontSize="11.5" TextWrapping="Wrap" Text="{x:Static props:Resources.rendering_note}"/>
