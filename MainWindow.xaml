<Window x:Class="FastbootEnhance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:props="clr-namespace:FastbootEnhance.Properties"
        xmlns:local="clr-namespace:FastbootEnhance"
        mc:Ignorable="d"
        Title="{x:Static props:Resources.app_name}"
        Height="780" Width="1220" MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SkyBrush}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="taskbariteminfo"/>
    </Window.TaskbarItemInfo>

    <Grid x:Name="root_grid">
    <TabControl x:Name="main_tabs" Style="{StaticResource NavRail}" SelectedIndex="1">

        <!-- The device bar above every page: which phone, in which mode, and the actions that apply to it. -->
        <local:Rail.TopBar>
            <Border x:Name="device_bar" Height="52" TextElement.Foreground="{StaticResource Text}" Background="{StaticResource Glass}" BorderBrush="{StaticResource GlassLine}" BorderThickness="0,0,0,1" Padding="20,0">
                <DockPanel VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="bar_cancel" Style="{StaticResource DangerButton}" MinHeight="32" Margin="0,0,8,0" Visibility="Collapsed"
                                Content="{x:Static props:Resources.bar_cancel}"/>
                        <Button x:Name="bar_reboot" Style="{StaticResource GhostButton}" MinHeight="32" Margin="0,0,8,0" Visibility="Collapsed"
                                Content="{x:Static props:Resources.bar_reboot}">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem x:Name="bar_reboot_system" Header="{x:Static props:Resources.fastboot_reboot_system}"/>
                                    <MenuItem x:Name="bar_reboot_bootloader" Header="{x:Static props:Resources.fastboot_reboot_bootloader}"/>
                                    <MenuItem x:Name="bar_reboot_fastbootd" Header="{x:Static props:Resources.fastboot_reboot_fastbootd}"/>
                                    <MenuItem x:Name="bar_reboot_recovery" Header="{x:Static props:Resources.fastboot_reboot_recovery}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="bar_disconnect" Style="{StaticResource GhostButton}" MinHeight="32" Visibility="Collapsed"
                                Foreground="{StaticResource Danger}" Content="{x:Static props:Resources.fastboot_remove_device}"/>
                        <Button x:Name="bar_usb_check" Style="{StaticResource GhostButton}" MinHeight="32" Content="{x:Static props:Resources.usb_check}"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" Background="{StaticResource Glass2}"
                            BorderBrush="{StaticResource GlassLine2}" BorderThickness="1" VerticalAlignment="Center">
                        <Path x:Name="bar_icon" FlowDirection="LeftToRight" Data="{StaticResource IconDevice}" Stroke="{StaticResource Dim}" StrokeThickness="1.7"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="bar_device_name" FontWeight="SemiBold" FontSize="13.5" Text="{x:Static props:Resources.bar_no_device}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="bar_device_detail" FontSize="11.5" Foreground="{StaticResource Dim}" Text="{x:Static props:Resources.bar_no_device_hint}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                        <Border x:Name="bar_mode_chip" Style="{StaticResource BarChip}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="bar_mode_dot" Width="7" Height="7" Fill="{StaticResource Ok}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="bar_mode_text" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="bar_lock_chip" Style="{StaticResource BarChip}" Visibility="Collapsed">
                            <TextBlock x:Name="bar_lock_text" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
        </local:Rail.TopBar>

        <!-- The status bar: how many phones fastboot sees, the last command, the tools' versions. -->
        <local:Rail.BottomBar>
            <Border x:Name="status_bar" Height="26" TextElement.Foreground="{StaticResource Text}" Background="{StaticResource Glass}" BorderBrush="{StaticResource GlassLine}" BorderThickness="0,1,0,0" Padding="16,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock x:Name="status_tools" DockPanel.Dock="Right" Style="{StaticResource StatusText}" FlowDirection="LeftToRight" FontFamily="{StaticResource Mono}"/>
                    <TextBlock x:Name="status_devices" Style="{StaticResource StatusText}"/>
                    <TextBlock x:Name="status_last" Style="{StaticResource StatusText}" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </local:Rail.BottomBar>

        <TabItem Style="{StaticResource NavGroup}" Header="{x:Static props:Resources.nav_group_phone}"/>
        <TabItem x:Name="device_tab" Header="{x:Static props:Resources.nav_device}" Tag="{StaticResource IconDevice}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PageHeader}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="fastboot_mode_badge" Style="{StaticResource Badge}" Margin="0,0,10,0" Visibility="Collapsed">
                                <TextBlock x:Name="fastboot_mode_text" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Accent}"/>
                            </Border>
                            <Border x:Name="fastboot_device_chip" Style="{StaticResource Chip}" Margin="0,0,10,0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Ok}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Label x:Name="fastboot_cur_device" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="fastboot_remove" Style="{StaticResource GhostButton}" Visibility="Collapsed"
                                    Content="{x:Static props:Resources.fastboot_remove_device}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static props:Resources.nav_device}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static props:Resources.device_subtitle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Margin="28,20,28,16">

                    <!-- Device picker -->
                    <Border x:Name="fastboot_devices_page" Style="{StaticResource Card}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <!-- Why a plugged-in phone is not listed: driver, or a mode fastboot cannot reach. -->
                                <Button x:Name="fastboot_usb_check" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Content="{x:Static props:Resources.usb_check}"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,4" Text="{x:Static props:Resources.device_list_title}"/>
                                    <TextBlock Style="{StaticResource Note}" Text="{x:Static props:Resources.device_list_hint}"/>
                                    <!-- Phones in Android, seen over adb: fastboot cannot list them. -->
                                    <TextBlock x:Name="fastboot_adb_note" Style="{StaticResource Note}" Margin="0,8,0,0"
                                               TextWrapping="Wrap" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                            <Grid>
                                <ListView x:Name="fastboot_devices_list" local:ColumnFill.Column="1" local:ColumnFill.MinWidth="120" SelectionMode="Single">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{x:Static props:Resources.fastboot_serial_num}" Width="300" DisplayMemberBinding="{Binding serial}"/>
                                            <GridViewColumn Header="{x:Static props:Resources.fastboot_device_name}" Width="240" DisplayMemberBinding="{Binding name}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock x:Name="fastboot_devices_empty" Style="{StaticResource Note}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                                           Text="{x:Static props:Resources.device_list_empty}"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Selected device -->
                    <Grid x:Name="fastboot_actions_page" Visibility="Collapsed">
                        <TabControl>
                            <TabItem x:Name="device_basic_tab" Header="{x:Static props:Resources.fastboot_basic_prop}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="380"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource Card}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="{x:Static props:Resources.device_variables}"/>
                                            <ListView x:Name="fastboot_info_list" local:ColumnFill.Column="1" local:ColumnFill.MinWidth="90">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="{x:Static props:Resources.fastboot_prop_name}" Width="165" DisplayMemberBinding="{Binding name}"/>
                                                        <GridViewColumn Header="{x:Static props:Resources.fastboot_prop_value}" Width="155" DisplayMemberBinding="{Binding value}"/>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                        </DockPanel>
                                    </Border>

                                    <StackPanel Grid.Column="2">
                                        <Border x:Name="fastboot_action_bar" Style="{StaticResource Card}" Margin="0,0,0,18">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static props:Resources.quick_actions}"/>
                                                <UniformGrid Columns="2">
                                                    <UniformGrid.Resources>
                                                        <!-- Longer labels (Arabic) wrap instead of being cut off. -->
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="ContentTemplate">
                                                                <Setter.Value>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </UniformGrid.Resources>
                                                    <Button x:Name="fastboot_reboot_d" Margin="0,0,6,8" Content="{x:Static props:Resources.fastboot_reboot_fastbootd}"/>
                                                    <Button x:Name="fastboot_ab_switch" Margin="6,0,0,8" Content="{x:Static props:Resources.fastboot_setactive_b}"/>
                                                    <Button x:Name="fastboot_reboot_system" Margin="0,0,6,8" Content="{x:Static props:Resources.fastboot_reboot_system}"/>
                                                    <Button x:Name="fastboot_reboot_recovery" Margin="6,0,0,8" Content="{x:Static props:Resources.fastboot_reboot_recovery}"/>
                                                </UniformGrid>
                                                <Button x:Name="fastboot_cancel_update" Style="{StaticResource WarnButton}" Visibility="Collapsed"
                                                        Content="{x:Static props:Resources.fastboot_cancel_update}"/>
                                                <Button x:Name="fastboot_boot_once" Margin="0,0,0,4" Content="{x:Static props:Resources.fastboot_boot_once}"/>
                                                <TextBlock Style="{StaticResource Note}" FontSize="11.5" Text="{x:Static props:Resources.fastboot_boot_once_note}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static props:Resources.preflash_checks}"/>
                                                <ItemsControl x:Name="fastboot_checks">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="18"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <TabItem x:Name="device_partitions_tab" Header="{x:Static props:Resources.fastboot_partition_table}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="240"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource Card}">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CardTitle}" Margin="0,0,14,0" VerticalAlignment="Center"
                                                           Text="{x:Static props:Resources.fastboot_partition_table}"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Static props:Resources.fastboot_filter_by_partition_name}" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBox FlowDirection="LeftToRight" x:Name="fastboot_partition_name_textbox" Width="240"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <ListView x:Name="fastboot_partition_list" local:ColumnFill.Column="0" local:ColumnFill.MinWidth="120">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="{x:Static props:Resources.fastboot_partition_name}" Width="205" DisplayMemberBinding="{Binding name}"/>
                                                        <GridViewColumn Header="{x:Static props:Resources.fastboot_partition_size}" Width="120" DisplayMemberBinding="{Binding size}"/>
                                                        <GridViewColumn Header="{x:Static props:Resources.fastboot_partition_is_dynamic}" Width="110" DisplayMemberBinding="{Binding is_logical}"/>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                        </DockPanel>
                                    </Border>

                                    <StackPanel Grid.Column="2">
                                    <Border x:Name="fastboot_single_part_op" Style="{StaticResource Card}" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static props:Resources.partition_actions}"/>
                                            <Button x:Name="fastboot_flash" Style="{StaticResource AccentButton}" Margin="0,0,0,8" Content="{x:Static props:Resources.fastboot_partition_action_flash}"/>
                                            <Button x:Name="fastboot_logical_create" Margin="0,0,0,8" Content="{x:Static props:Resources.fastboot_partition_action_create}"/>
                                            <Button x:Name="fastboot_logical_resize" Margin="0,0,0,8" Content="{x:Static props:Resources.fastboot_partition_action_resize}"/>
                                            <Button x:Name="fastboot_erase" Style="{StaticResource DangerButton}" Margin="0,8,0,8" Content="{x:Static props:Resources.fastboot_partition_action_erase}"/>
                                            <Button x:Name="fastboot_logical_delete" Style="{StaticResource DangerButton}" Content="{x:Static props:Resources.fastboot_partition_action_delete}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- How super is shared out; fastbootd only lists logical partitions. -->
                                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static props:Resources.super_space_title}"/>
                                            <ProgressBar x:Name="fastboot_super_bar" Height="8" Margin="0,0,0,10" Maximum="100"/>
                                            <TextBlock x:Name="fastboot_super_text" Style="{StaticResource Note}" FontSize="12" LineHeight="18" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>

                <ProgressBar x:Name="fastboot_progress_bar" Grid.Row="2" Margin="28,0,28,16" Visibility="Hidden"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="phone_tab" Header="{x:Static props:Resources.nav_phone}" Tag="{StaticResource IconPhoneInfo}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PageHeader}">
                    <DockPanel LastChildFill="True">
                        <StackPanel x:Name="phone_header_actions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Style="{StaticResource Chip}" Padding="10,4" Margin="0,0,12,0">
                                <TextBlock x:Name="phone_serial" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Dim}"/>
                            </Border>
                            <Button x:Name="phone_reboot_recovery" Margin="0,0,8,0" Content="{x:Static props:Resources.phone_reboot_recovery}"/>
                            <Button x:Name="phone_reboot_fastbootd" Margin="0,0,8,0" Content="fastbootd"/>
                            <Button x:Name="phone_reboot_bootloader" Style="{StaticResource AccentButton}" Content="{x:Static props:Resources.phone_reboot_bootloader}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static props:Resources.nav_phone}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static props:Resources.phone_subtitle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- No phone in Android yet -->
                <Border x:Name="phone_empty" Grid.Row="1" Margin="28,18,28,18" Style="{StaticResource Card}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                        <Path Data="{StaticResource IconPhoneInfo}" Stroke="{StaticResource Faint}" StrokeThickness="1.6" Width="34" Height="34"
                              Stretch="Uniform" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,0,14"/>
                        <TextBlock x:Name="phone_empty_title" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" TextAlignment="Center"
                                   Text="{x:Static props:Resources.phone_empty_title}"/>
                        <TextBlock x:Name="phone_empty_text" Style="{StaticResource Note}" FontSize="12.5" TextAlignment="Center"
                                   Text="{x:Static props:Resources.phone_empty_text}"/>
                    </StackPanel>
                </Border>

                <!-- The phone: the page scrolls as a whole, so every backup is in the table on a small screen too -->
                <ScrollViewer x:Name="phone_page" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <!-- Three cards side by side on a wide window; on a narrower one the Companion goes under the other two (PhoneUI.layout). -->
                    <Grid x:Name="phone_grid" Margin="28,18,28,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="phone_gap_column" Width="16"/>
                            <ColumnDefinition x:Name="phone_third_column" Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <DataTemplate x:Key="PhoneInfoRow">
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Dim}" FontSize="12.5"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{Binding Font}" FontSize="12.5"
                                               FlowDirection="{Binding Flow}" HorizontalAlignment="Left" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </Grid.Resources>

                        <!-- Device -->
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Border x:Name="phone_soc_chip" DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="10,2" Visibility="Collapsed">
                                        <TextBlock x:Name="phone_soc" FontSize="11.5" Foreground="{StaticResource Dim}"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,10,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{x:Static props:Resources.phone_card_device}"/>
                                </DockPanel>
                                <ItemsControl x:Name="phone_device_rows" ItemTemplate="{StaticResource PhoneInfoRow}"/>
                            </DockPanel>
                        </Border>

                        <!-- Kernel and security -->
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Border x:Name="phone_avb_chip" DockPanel.Dock="Right" Style="{StaticResource Badge}" Padding="10,2" Visibility="Collapsed">
                                        <TextBlock x:Name="phone_avb" FontSize="11.5" FontFamily="{StaticResource Mono}"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,10,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{x:Static props:Resources.phone_card_security}"/>
                                </DockPanel>
                                <StackPanel>
                                    <ItemsControl x:Name="phone_security_rows" ItemTemplate="{StaticResource PhoneInfoRow}"/>
                                    <TextBlock x:Name="phone_avb_note" Style="{StaticResource Note}" FontSize="11.5" Margin="0,6,0,0"/>
                                    <DockPanel Margin="0,8,0,0">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource Ok}" VerticalAlignment="Top" Margin="0,6,8,0"/>
                                        <TextBlock Style="{StaticResource Note}" FontSize="11.5" Text="{x:Static props:Resources.phone_boot_checked}"/>
                                    </DockPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Fastboot Studio Companion -->
                        <Border x:Name="phone_companion_card" Grid.Column="4" Style="{StaticResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Border x:Name="phone_companion_chip" DockPanel.Dock="Right" Style="{StaticResource Badge}" Padding="10,2" Visibility="Collapsed">
                                        <TextBlock x:Name="phone_companion_version" FontSize="11.5" Foreground="{StaticResource Accent}"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,10,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="Fastboot Studio Companion"/>
                                </DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <DockPanel>
                                        <Ellipse x:Name="phone_companion_dot" Width="7" Height="7" Fill="{StaticResource Faint}" VerticalAlignment="Top" Margin="0,6,8,0"/>
                                        <TextBlock x:Name="phone_companion_text" Style="{StaticResource Note}" FontSize="12"/>
                                    </DockPanel>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="phone_companion_get" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Visibility="Collapsed"
                                                Content="{x:Static props:Resources.phone_companion_get}"/>
                                        <Button x:Name="phone_companion_retry" Visibility="Collapsed" Content="{x:Static props:Resources.phone_read_again}"/>
                                    </WrapPanel>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="190">
                                    <ItemsControl x:Name="phone_conflicts">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                        CornerRadius="8" Margin="0,0,0,8">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Width="3" CornerRadius="8,0,0,8" Background="{Binding Brush}"/>
                                                        <StackPanel Margin="10,7,10,8">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Dim}"
                                                                       FlowDirection="LeftToRight" TextAlignment="Left" HorizontalAlignment="Left"
                                                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Backups on the phone -->
                        <Border Grid.Row="3" Grid.ColumnSpan="5" Style="{StaticResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Margin="0,0,0,10" Text="{x:Static props:Resources.phone_card_backups}"/>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Border Style="{StaticResource Chip}" Padding="10,3" Margin="0,0,8,0">
                                            <TextBlock x:Name="phone_backups_summary" FontSize="11.5" Foreground="{StaticResource Dim}"/>
                                        </Border>
                                        <Border x:Name="phone_backups_last_chip" Style="{StaticResource Chip}" Padding="10,3" Margin="0,0,12,0">
                                            <TextBlock x:Name="phone_backups_last" FontSize="11.5" Foreground="{StaticResource Dim}"/>
                                        </Border>
                                        <Button x:Name="phone_read_again" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Content="{x:Static props:Resources.phone_read_again}"/>
                                        <Button x:Name="phone_backups_open" Content="{x:Static props:Resources.phone_backups_open}"/>
                                    </WrapPanel>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" FontSize="11.5" Margin="0,10,0,0" Text="{x:Static props:Resources.phone_backups_note}"/>
                                <Grid MinHeight="90">
                                    <ListView x:Name="phone_backups" local:ColumnFill.Column="0" local:ColumnFill.MinWidth="86" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="{x:Static props:Resources.phone_col_backup}" Width="300">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="12" ToolTip="{Binding Name}"
                                                                       FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{x:Static props:Resources.phone_col_type}" Width="74">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{Binding TypeBrush}" BorderThickness="1" CornerRadius="10" Padding="9,1" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Type}" Foreground="{Binding TypeBrush}" FontSize="11"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{x:Static props:Resources.phone_col_files}" Width="48" DisplayMemberBinding="{Binding Files}"/>
                                                <GridViewColumn Header="{x:Static props:Resources.phone_col_size}" Width="76" DisplayMemberBinding="{Binding Size}"/>
                                                <GridViewColumn Header="{x:Static props:Resources.phone_col_date}" Width="116" DisplayMemberBinding="{Binding Date}"/>
                                                <GridViewColumn Header="{x:Static props:Resources.phone_col_pc}" Width="140">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding OnPc}" Foreground="{Binding OnPcBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding OnPc}"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Width="122">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Tag="{Binding}" Style="{StaticResource AccentButton}" Height="28" Padding="9,0"
                                                                        Content="{x:Static props:Resources.phone_copy}" Visibility="{Binding CopyVisibility}" IsEnabled="{Binding Idle}"/>
                                                                <Button Tag="{Binding}" Height="28" Padding="9,0"
                                                                        Content="{x:Static props:Resources.phone_open}" Visibility="{Binding OpenVisibility}" IsEnabled="{Binding Idle}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock x:Name="phone_backups_empty" Style="{StaticResource Note}" FontSize="12.5" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" TextAlignment="Center" MaxWidth="520" Visibility="Collapsed"
                                               Text="{x:Static props:Resources.phone_backups_empty}"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem x:Name="flash_tab" Header="{x:Static props:Resources.nav_flash}" Tag="{StaticResource IconFlash}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PageHeader}">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}">
                            <TextBlock x:Name="flash_target_device" FontFamily="{StaticResource UiFont}" FontSize="12"
                                       Text="{x:Static props:Resources.flash_target_none}"/>
                        </Border>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static props:Resources.fastboot_flash_payload}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static props:Resources.flash_subtitle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Margin="28,16,28,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- The result, in place of a pop-up: how many partitions were written, in how long. -->
                    <Border x:Name="flash_result" Style="{StaticResource Card}" Background="{StaticResource OkSoft}" BorderBrush="{StaticResource OkLine}"
                            Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="flash_result_log" Style="{StaticResource GhostButton}" MinHeight="32" Margin="0,0,8,0" Content="{x:Static props:Resources.flash_result_log}"/>
                                <Button x:Name="flash_result_reboot" Style="{StaticResource AccentButton}" MinHeight="32" Content="{x:Static props:Resources.flash_result_reboot}"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" Background="{StaticResource OkSoft}" BorderBrush="{StaticResource OkLine}" BorderThickness="1" Margin="0,0,14,0">
                                <Path FlowDirection="LeftToRight" Data="M5,12.5 L10,17.5 L19.5,7" Stroke="{StaticResource Ok}" StrokeThickness="2.4" Width="16" Height="16" Stretch="Uniform"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="flash_result_title" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="flash_result_detail" Style="{StaticResource Note}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock x:Name="flash_file_name" FontSize="15" FontWeight="SemiBold" Text="{x:Static props:Resources.flash_no_payload}"/>
                                    <TextBlock x:Name="flash_file_detail" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Dim}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static props:Resources.label_phase}"/>
                                        <TextBlock x:Name="flash_phase" Style="{StaticResource StatValue}" FontFamily="{StaticResource UiFont}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="{x:Static props:Resources.flash_phase_idle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static props:Resources.label_elapsed}"/>
                                        <TextBlock x:Name="flash_elapsed" Style="{StaticResource StatValue}" Text="00:00"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static props:Resources.label_written}"/>
                                        <TextBlock x:Name="flash_count" Style="{StaticResource StatValue}" Text="0 / 0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar x:Name="flash_overall_progress" Height="8"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="0.85*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="{x:Static props:Resources.payload_partitions}"/>
                                <ListView x:Name="flash_queue" local:ColumnFill.Column="2" local:ColumnFill.MinWidth="60">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{x:Static props:Resources.column_partition}" Width="150">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                            <!-- Boot chain, identity: a wrong image here can leave the phone unable to start. -->
                                                            <Border Style="{StaticResource Badge}" Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnLine}"
                                                                    Padding="6,1" Margin="8,0,0,0" Visibility="{Binding CriticalVisibility}">
                                                                <TextBlock Text="{x:Static props:Resources.flash_critical}" FontSize="10.5" Foreground="{StaticResource Warn}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{x:Static props:Resources.column_size}" Width="85" DisplayMemberBinding="{Binding Size}"/>
                                            <GridViewColumn Header="{x:Static props:Resources.column_progress}" Width="115">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ProgressBar Margin="0,0,12,0" Value="{Binding Progress, Mode=OneWay}" Foreground="{Binding StateBrush}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{x:Static props:Resources.column_state}" Width="120">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="20" Height="20" CornerRadius="6" Background="{Binding StateSoftBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <Path FlowDirection="LeftToRight" Data="{Binding StateGlyph}" Stroke="{Binding StateBrush}" StrokeThickness="2.2" Width="11" Height="11" Stretch="Uniform"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Button x:Name="fastboot_flash_payload" Style="{StaticResource AccentButton}" MinHeight="42" Margin="0,0,0,14"
                                            Content="{x:Static props:Resources.fastboot_flash_payload}"/>
                                    <CheckBox x:Name="ignore_unknown_part" Margin="0,0,0,10" Content="{x:Static props:Resources.fastboot_ignore_unknown}"/>
                                    <CheckBox x:Name="flash_both_slots" Margin="0,0,0,4" Content="{x:Static props:Resources.flash_both_slots}"/>
                                    <TextBlock Style="{StaticResource Note}" FontSize="11.5" Margin="26,0,0,0" Text="{x:Static props:Resources.flash_both_slots_note}"
                                               ToolTip="{x:Static props:Resources.flash_note_order}"/>
                                </StackPanel>
                            </Border>
                            <!-- The live log: what fastboot says while it writes. -->
                            <Border Grid.Row="2" Style="{StaticResource Card}" Background="{StaticResource Well}" Padding="16,12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" Text="{x:Static props:Resources.live_log}"
                                               ToolTip="{x:Static props:Resources.flash_note_verify}"/>
                                    <TextBox FlowDirection="LeftToRight" x:Name="flash_log" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                             FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Dim}"
                                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem x:Name="backup_tab" Header="{x:Static props:Resources.nav_backup}" Tag="{StaticResource IconBackup}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PageHeader}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static props:Resources.nav_backup}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static props:Resources.backup_subtitle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Margin="28,16,28,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Device over adb -->
                    <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static props:Resources.backup_adb_devices}"/>
                                <Grid>
                                    <ListView x:Name="backup_devices" SelectionMode="Single" MaxHeight="104"
                                              local:ColumnFill.Column="1" local:ColumnFill.MinWidth="90">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="{x:Static props:Resources.fastboot_serial_num}" Width="170" DisplayMemberBinding="{Binding Serial}"/>
                                                <GridViewColumn Header="{x:Static props:Resources.backup_column_model}" Width="160" DisplayMemberBinding="{Binding Model}"/>
                                                <GridViewColumn Header="{x:Static props:Resources.backup_column_mode}" Width="100" DisplayMemberBinding="{Binding State}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock x:Name="backup_devices_empty" Style="{StaticResource Note}" Margin="10,36,10,6"
                                               Text="{x:Static props:Resources.backup_waiting}"/>
                                </Grid>
                            </StackPanel>
                            <Border Grid.Column="1" Margin="20,0,0,0" Padding="16,0,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                                <TextBlock x:Name="backup_device_note" Style="{StaticResource Note}" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- The phone is in fastboot: say why backup cannot work there and how to get out of it. -->
                    <Border x:Name="backup_fastboot_panel" Grid.Row="1" Style="{StaticResource WarnCard}" VerticalAlignment="Top"
                            Visibility="Collapsed" Panel.ZIndex="1">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" Background="{StaticResource WarnSoft}"
                                        BorderBrush="{StaticResource WarnLine}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <Path FlowDirection="LeftToRight" Data="M12,3 L22,20.5 H2 Z M12,9.5 V14 M12,17 V17.5" Stroke="{StaticResource Warn}"
                                          StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stretch="Uniform" Width="18" Height="18"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock x:Name="backup_fb_title" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                                    <TextBlock Style="{StaticResource Note}" Text="{x:Static props:Resources.backup_fb_why}"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="48,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static props:Resources.backup_fb_android}"/>
                                    <TextBlock Style="{StaticResource Note}" Text="{x:Static props:Resources.backup_fb_android_note}"/>
                                </StackPanel>
                                <Button x:Name="backup_fb_reboot_system" Grid.Column="1" MinWidth="190" VerticalAlignment="Top" Margin="0,0,0,14"
                                        Content="{x:Static props:Resources.fastboot_reboot_system}"/>

                                <StackPanel Grid.Row="1" Margin="0,0,16,14">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static props:Resources.backup_fb_recovery}"/>
                                    <TextBlock Style="{StaticResource Note}" Text="{x:Static props:Resources.backup_fb_recovery_note}"/>
                                </StackPanel>
                                <Button x:Name="backup_fb_reboot_recovery" Grid.Row="1" Grid.Column="1" MinWidth="190" VerticalAlignment="Top" Margin="0,0,0,14"
                                        Content="{x:Static props:Resources.fastboot_reboot_recovery}"/>

                                <StackPanel Grid.Row="2" Margin="0,0,16,0">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static props:Resources.backup_fb_boot}"/>
                                    <TextBlock Style="{StaticResource Note}" Text="{x:Static props:Resources.backup_fb_boot_note}"/>
                                </StackPanel>
                                <Button x:Name="backup_fb_boot_image" Grid.Row="2" Grid.Column="1" MinWidth="190" VerticalAlignment="Top"
                                        Style="{StaticResource AccentButton}" Content="{x:Static props:Resources.backup_fb_boot_button}"/>
                            </Grid>

                            <TextBlock x:Name="backup_fb_status" Style="{StaticResource Note}" Margin="48,14,0,0" Foreground="{StaticResource Accent}"/>
                        </StackPanel>
                    </Border>

                    <TabControl x:Name="backup_tabs" Grid.Row="1">
                        <!-- Partitions -->
                        <TabItem x:Name="backup_partitions_tab" Header="{x:Static props:Resources.backup_tab_partitions}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <Button x:Name="backup_read" Style="{StaticResource AccentButton}" Margin="0,0,8,4"
                                                    Content="{x:Static props:Resources.backup_read}"/>
                                            <Button x:Name="backup_select_critical" Margin="0,0,8,4"
                                                    Content="{x:Static props:Resources.backup_select_critical}"/>
                                            <Button x:Name="backup_select_none" Style="{StaticResource GhostButton}" Margin="0,0,0,4"
                                                    Content="{x:Static props:Resources.backup_select_none}"/>
                                        </WrapPanel>
                                        <TextBox x:Name="backup_filter" DockPanel.Dock="Top" Margin="0,0,0,10" Tag="{x:Static props:Resources.backup_filter_hint}"/>
                                        <ListView x:Name="backup_partition_list" SelectionMode="Single"
                                                  local:ColumnFill.Column="3" local:ColumnFill.MinWidth="50">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Width="38">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Focusable="False"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="{x:Static props:Resources.column_partition}" Width="130" DisplayMemberBinding="{Binding Name}"/>
                                                    <GridViewColumn Header="{x:Static props:Resources.column_size}" Width="85" DisplayMemberBinding="{Binding Size}"/>
                                                    <GridViewColumn Header="{x:Static props:Resources.column_progress}" Width="100">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <ProgressBar Margin="0,0,12,0" Value="{Binding Progress, Mode=OneWay}" Foreground="{Binding StateBrush}"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="{x:Static props:Resources.column_state}" Width="80">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" FontWeight="SemiBold"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static props:Resources.backup_save_to}"/>
                                        <DockPanel Margin="0,0,0,14">
                                            <Button x:Name="backup_change_folder" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,4"
                                                    Content="{x:Static props:Resources.backup_change}"/>
                                            <TextBlock x:Name="backup_save_root" FlowDirection="LeftToRight" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Dim}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <Button x:Name="backup_start" Style="{StaticResource AccentButton}" Content="{x:Static props:Resources.backup_start}"/>
                                        <Button x:Name="backup_cancel" Style="{StaticResource DangerButton}" Margin="0,8,0,0" Visibility="Collapsed"
                                                Content="{x:Static props:Resources.backup_cancel}"/>
                                        <ProgressBar x:Name="backup_progress" Height="6" Margin="0,14,0,6"/>
                                        <TextBlock x:Name="backup_progress_text" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Dim}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                                        <Button x:Name="backup_verify" Margin="0,0,0,8" Content="{x:Static props:Resources.backup_verify}"/>
                                        <Button x:Name="backup_open_folder" Style="{StaticResource GhostButton}" Margin="0,0,0,14" Content="{x:Static props:Resources.backup_open_folder}"/>
                                        <TextBlock Style="{StaticResource Note}" Text="{x:Static props:Resources.backup_note}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- Files -->
                        <TabItem x:Name="backup_files_tab" Header="{x:Static props:Resources.backup_tab_files}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
                                            <Button x:Name="files_up" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Padding="12,6"
                                                    Content="{x:Static props:Resources.files_up}"/>
                                            <Button x:Name="files_go" DockPanel.Dock="Right" Margin="8,0,0,0" Content="{x:Static props:Resources.files_go}"/>
                                            <TextBox FlowDirection="LeftToRight" x:Name="files_path" FontFamily="{StaticResource Mono}" Text="/sdcard"/>
                                        </DockPanel>
                                        <WrapPanel x:Name="files_quick_bar" DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Button x:Name="files_quick_storage" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,6,0" FontSize="12"
                                                    Tag="/sdcard" Content="{x:Static props:Resources.files_quick_storage}"/>
                                            <Button x:Name="files_quick_dcim" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,6,0" FontSize="12"
                                                    Tag="/sdcard/DCIM" Content="{x:Static props:Resources.files_quick_dcim}"/>
                                            <Button x:Name="files_quick_pictures" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,6,0" FontSize="12"
                                                    Tag="/sdcard/Pictures" Content="{x:Static props:Resources.files_quick_pictures}"/>
                                            <Button x:Name="files_quick_download" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,6,0" FontSize="12"
                                                    Tag="/sdcard/Download" Content="{x:Static props:Resources.files_quick_download}"/>
                                            <Button x:Name="files_quick_documents" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12"
                                                    Tag="/sdcard/Documents" Content="{x:Static props:Resources.files_quick_documents}"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="files_status" DockPanel.Dock="Bottom" Style="{StaticResource Note}" Margin="2,8,0,0"/>
                                        <Grid>
                                            <ListView x:Name="files_list" SelectionMode="Extended"
                                                      local:ColumnFill.Column="0" local:ColumnFill.MinWidth="160">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="{x:Static props:Resources.files_column_name}" Width="240">
                                                            <GridViewColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Path Data="{Binding Icon}" Stroke="{Binding IconBrush}" StrokeThickness="1.6"
                                                                              StrokeLineJoin="Round" Stretch="Uniform" Width="15" Height="15" Margin="0,0,9,0"/>
                                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </GridViewColumn.CellTemplate>
                                                        </GridViewColumn>
