                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource FormatChip}" Margin="0,0,12,8"><TextBlock Text="Ctrl+O"/></Border>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Note}" Margin="0,0,0,8" VerticalAlignment="Center" Text="{x:Static props:Resources.shortcut_open}"/>
                                    <Border Grid.Row="1" Style="{StaticResource FormatChip}" Margin="0,0,12,8"><TextBlock Text="Ctrl+L"/></Border>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Note}" Margin="0,0,0,8" VerticalAlignment="Center" Text="{x:Static props:Resources.shortcut_log}"/>
                                    <Border Grid.Row="2" Style="{StaticResource FormatChip}" Margin="0,0,12,8"><TextBlock Text="F1"/></Border>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Note}" Margin="0,0,0,8" VerticalAlignment="Center" Text="{x:Static props:Resources.shortcut_help}"/>
                                    <Border Grid.Row="3" Style="{StaticResource FormatChip}" Margin="0,0,12,0"><TextBlock Text="Ctrl+,"/></Border>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Note}" VerticalAlignment="Center" Text="{x:Static props:Resources.shortcut_settings}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" Grid.RowSpan="2">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,12" Text="{x:Static props:Resources.language}"/>
                                    <WrapPanel x:Name="language_buttons"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Button x:Name="update_check_now" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" MinHeight="32" Margin="12,0,0,0"
                                                VerticalAlignment="Center" Content="{x:Static props:Resources.update_check_now}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource CardTitle}" Margin="0" Text="{x:Static props:Resources.update_section}"/>
                                            <TextBlock Text="{x:Static local:MainWindow.versionLabel}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <CheckBox x:Name="update_auto" Margin="0,0,0,2" Content="{x:Static props:Resources.update_auto}"/>
                                    <TextBlock Style="{StaticResource Note}" FontSize="11.5" Margin="26,0,0,8" TextWrapping="Wrap"
                                               Text="{x:Static props:Resources.update_auto_note}"/>
                                    <TextBlock x:Name="update_status" Foreground="{StaticResource Dim}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,4" Text="{x:Static props:Resources.driver_section}"/>
                                    <TextBlock Style="{StaticResource Note}" FontSize="11.5" Margin="0,0,0,12" TextWrapping="Wrap"
                                               Text="{x:Static props:Resources.driver_section_note}"/>
                                    <DockPanel Margin="0,0,0,10">
                                        <Button x:Name="settings_google_driver" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" MinHeight="32" Margin="12,0,0,0"
                                                VerticalAlignment="Center" Content="{x:Static props:Resources.driver_install}"/>
                                        <Ellipse x:Name="settings_google_driver_dot" DockPanel.Dock="Left" Width="9" Height="9" Fill="{StaticResource Faint}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Static props:Resources.driver_google_title}"/>
                                            <TextBlock x:Name="settings_google_driver_status" Style="{StaticResource Note}" FontSize="11.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel>
                                        <Button x:Name="settings_samsung_driver" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" MinHeight="32" Margin="12,0,0,0"
                                                VerticalAlignment="Center" Content="{x:Static props:Resources.driver_install}"/>
                                        <Ellipse x:Name="settings_samsung_driver_dot" DockPanel.Dock="Left" Width="9" Height="9" Fill="{StaticResource Faint}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Static props:Resources.driver_samsung_title}"/>
                                            <TextBlock x:Name="settings_samsung_driver_status" Style="{StaticResource Note}" FontSize="11.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,12" Text="{x:Static props:Resources.settings_phone}"/>
                                    <CheckBox x:Name="root_probe" Margin="0,0,0,2" Content="{x:Static props:Resources.root_probe}"/>
                                    <TextBlock Style="{StaticResource Note}" FontSize="11.5" Margin="26,0,0,0" TextWrapping="Wrap"
                                               Text="{x:Static props:Resources.root_probe_note}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,12" Text="{x:Static props:Resources.welcome_section}"/>
                                    <WrapPanel>
                                        <Button x:Name="about_welcome" Style="{StaticResource GhostButton}" Margin="0,0,10,8"
                                                Content="{x:Static props:Resources.welcome_show_again}"/>
                                        <Button x:Name="about_whats_new" Style="{StaticResource GhostButton}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem Style="{StaticResource NavRule}" DockPanel.Dock="Bottom"/>
    </TabControl>

    <!-- ============================== Help: the page's ؟ opens it at the side ============================== -->
    <!-- Over the page only: the sidebar stays usable, and switching pages shows that page's help. -->
    <Grid x:Name="help_layer" Margin="224,0,0,0" Visibility="Collapsed">
        <Border x:Name="help_scrim" Background="#59000000"/>
        <Border x:Name="help_panel" HorizontalAlignment="Right" Width="420" Background="{StaticResource Well}"
                BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="22,16,14,10">
                    <Button x:Name="help_close" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" MinHeight="30" Padding="10,0"
                            BorderThickness="0" Content="✕" ToolTip="{x:Static props:Resources.help_close}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0" Text="{x:Static props:Resources.help_label}"/>
                        <TextBlock x:Name="help_title" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,10">
                    <DockPanel>
                        <Button x:Name="help_ask" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" MinHeight="30"
                                Content="{x:Static props:Resources.help_ask}"/>
                        <TextBlock Style="{StaticResource Note}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Text="{x:Static props:Resources.help_ask_note}"/>
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="help_scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <StackPanel x:Name="help_body" Margin="22,14,22,22"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>

    <!-- ============================== Welcome and What's new ============================== -->
    <!-- The first start (a short tour), or the first start of a new version (what changed). -->
    <Grid x:Name="welcome_layer" Visibility="Collapsed" Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="welcome_scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="48,34,48,12" MaxWidth="980">
                <TextBlock x:Name="welcome_title" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="welcome_subtitle" Style="{StaticResource Note}" FontSize="13.5" LineHeight="21"
                           HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="680" Margin="0,8,0,24"/>
                <ContentControl x:Name="welcome_body" Focusable="False"/>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="48,8,48,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="welcome_back" HorizontalAlignment="Left" Style="{StaticResource GhostButton}" MinWidth="110" MinHeight="40"/>
            <StackPanel x:Name="welcome_dots" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
            <Button x:Name="welcome_next" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource AccentButton}"
                    MinWidth="140" MinHeight="40" IsDefault="True"/>
        </Grid>
    </Grid>
    </Grid>
</Window>
