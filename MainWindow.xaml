                                    <ListView x:Name="images_chunks" local:ColumnFill.Column="4" local:ColumnFill.MinWidth="80">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="#" Width="60" DisplayMemberBinding="{Binding Index}"/>
                                                <GridViewColumn Header="{x:Static props:Resources.images_column_type}" Width="100" DisplayMemberBinding="{Binding Type}"/>
                                                <GridViewColumn Header="{x:Static props:Resources.images_column_start}" Width="110" DisplayMemberBinding="{Binding Start}"/>
                                                <GridViewColumn Header="{x:Static props:Resources.images_column_blocks}" Width="90" DisplayMemberBinding="{Binding Blocks}"/>
                                                <GridViewColumn Header="{x:Static props:Resources.column_size}" Width="100" DisplayMemberBinding="{Binding Size}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Border>
                            </TabItem>
                        </TabControl>

                        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static props:Resources.backup_save_to}"/>
                                <DockPanel Margin="0,0,0,14">
                                    <Button x:Name="images_change_folder" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,4"
                                            Content="{x:Static props:Resources.backup_change}"/>
                                    <TextBlock x:Name="images_out_folder" FlowDirection="LeftToRight" FontFamily="{StaticResource Mono}" FontSize="11.5"
                                               Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                </DockPanel>

                                <Button x:Name="images_extract" Style="{StaticResource AccentButton}" Margin="0,0,0,8" Visibility="Collapsed"
                                        Content="{x:Static props:Resources.images_extract}"/>
                                <Button x:Name="images_to_raw" Style="{StaticResource AccentButton}" Margin="0,0,0,8" Visibility="Collapsed"
                                        Content="{x:Static props:Resources.images_to_raw}"/>
                                <Button x:Name="images_to_sparse" Margin="0,0,0,8" Visibility="Collapsed"
                                        Content="{x:Static props:Resources.images_to_sparse}"/>

                                <CheckBox x:Name="images_split" Margin="0,4,0,6" Content="{x:Static props:Resources.images_split}"/>
                                <DockPanel x:Name="images_split_row" Margin="26,0,0,12">
                                    <TextBlock DockPanel.Dock="Right" Text="MB" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox x:Name="images_split_mb" FlowDirection="LeftToRight" FontFamily="{StaticResource Mono}" Text="512"/>
                                </DockPanel>

                                <Button x:Name="images_cancel" Style="{StaticResource DangerButton}" Margin="0,0,0,8" Visibility="Collapsed"
                                        Content="{x:Static props:Resources.backup_cancel}"/>
                                <ProgressBar x:Name="images_progress" Height="6" Margin="0,4,0,6"/>
                                <TextBlock x:Name="images_progress_text" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Dim}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                                <Button x:Name="images_open_folder" Style="{StaticResource GhostButton}" Margin="0,0,0,14"
                                        Content="{x:Static props:Resources.backup_open_folder}"/>
                                <TextBlock x:Name="images_note" Style="{StaticResource Note}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem x:Name="super_tab" Header="{x:Static props:Resources.nav_super}" Tag="{StaticResource IconBricks}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PageHeader}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="super_import" Margin="0,0,10,0" Content="{x:Static props:Resources.super_import}"/>
                            <Button x:Name="super_read_phone" Style="{StaticResource GhostButton}" Content="{x:Static props:Resources.super_read_phone}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static props:Resources.nav_super}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static props:Resources.super_subtitle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="28,20,28,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="290"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="super_editor">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*" MinHeight="260"/>
                        </Grid.RowDefinitions>

                        <!-- Layout: slots, size, group -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static props:Resources.super_layout}"/>
                                <WrapPanel>
                                    <RadioButton x:Name="super_mode_vab" Style="{StaticResource Segment}" GroupName="super_mode" IsChecked="True"
                                                 Content="{x:Static props:Resources.super_mode_vab}"/>
                                    <RadioButton x:Name="super_mode_ab" Style="{StaticResource Segment}" GroupName="super_mode"
                                                 Content="{x:Static props:Resources.super_mode_ab}"/>
                                    <RadioButton x:Name="super_mode_single" Style="{StaticResource Segment}" GroupName="super_mode"
                                                 Content="{x:Static props:Resources.super_mode_single}"/>
                                    <RadioButton x:Name="super_mode_imported" Style="{StaticResource Segment}" GroupName="super_mode" Visibility="Collapsed"
                                                 Content="{x:Static props:Resources.super_mode_imported}"/>
                                </WrapPanel>
                                <TextBlock x:Name="super_mode_note" Style="{StaticResource Note}" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static props:Resources.super_size}"/>
                                        <TextBox x:Name="super_size" FlowDirection="LeftToRight" FontFamily="{StaticResource Mono}"
                                                 Tag="{x:Static props:Resources.super_size_hint}"/>
                                        <TextBlock x:Name="super_size_human" Style="{StaticResource Note}" Margin="2,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static props:Resources.super_group_name}"/>
                                        <TextBox x:Name="super_group" FlowDirection="LeftToRight" FontFamily="{StaticResource Mono}" Text="main"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static props:Resources.super_group_size}"/>
                                        <TextBox x:Name="super_group_size" FlowDirection="LeftToRight" FontFamily="{StaticResource Mono}"
                                                 Tag="{x:Static props:Resources.super_auto}"/>
                                        <TextBlock x:Name="super_group_size_human" Style="{StaticResource Note}" Margin="2,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock x:Name="super_usage_text" DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,0,0,6"/>
                                    <ProgressBar x:Name="super_usage" Height="8"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Partitions -->
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Button x:Name="super_add" Style="{StaticResource AccentButton}" Margin="0,0,8,6" Content="{x:Static props:Resources.super_add}"/>
                                    <Button x:Name="super_add_folder" Margin="0,0,8,6" Content="{x:Static props:Resources.super_add_folder}"/>
                                    <Button x:Name="super_remove" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Content="{x:Static props:Resources.super_remove}"/>
                                    <Button x:Name="super_clear" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Content="{x:Static props:Resources.super_clear}"/>
                                </WrapPanel>
                                <Grid>
                                    <ListView x:Name="super_partitions" SelectionMode="Extended" AllowDrop="True"
                                              local:ColumnFill.Column="3" local:ColumnFill.MinWidth="90">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="{x:Static props:Resources.column_partition}" Width="115">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontFamily="{StaticResource Mono}" FontSize="12.5"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{x:Static props:Resources.images_column_group}" Width="100">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Group}" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{x:Static props:Resources.column_size}" Width="80" DisplayMemberBinding="{Binding Size}"/>
                                                <GridViewColumn Header="{x:Static props:Resources.super_column_image}" Width="150">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Image}" ToolTip="{Binding ImagePath}" Foreground="{Binding ImageBrush}"
                                                                       FlowDirection="{Binding ImageFlow}" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <!-- Nothing imported yet: the drop frame, over the empty list. -->
                                    <Grid x:Name="super_partitions_empty" IsHitTestVisible="False" Margin="14,24,14,14" VerticalAlignment="Top">
                                        <Rectangle RadiusX="16" RadiusY="16" Stroke="{StaticResource GlassLine2}" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="{StaticResource Glass}"/>
                                        <StackPanel HorizontalAlignment="Center" Margin="30,28">
                                            <Border Style="{StaticResource EmptyIcon}" Width="60" Height="60" CornerRadius="16" Margin="0,0,0,14">
                                                <Path Data="{StaticResource IconBricks}" Stroke="{StaticResource Accent}" StrokeThickness="1.6"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="17"/>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{x:Static props:Resources.super_drop_hint}"/>
                                            <TextBlock Style="{StaticResource Note}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,10" MaxWidth="420"
                                                       Text="{x:Static props:Resources.super_drop_detail}"/>
                                            <WrapPanel HorizontalAlignment="Center" FlowDirection="LeftToRight">
                                                <Border Style="{StaticResource FormatChip}"><TextBlock Text="system.img"/></Border>
                                                <Border Style="{StaticResource FormatChip}"><TextBlock Text="vendor.img"/></Border>
                                                <Border Style="{StaticResource FormatChip}"><TextBlock Text="product.img"/></Border>
                                                <Border Style="{StaticResource FormatChip}"><TextBlock Text="sparse"/></Border>
                                                <Border Style="{StaticResource FormatChip}"><TextBlock Text="raw"/></Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Output and build -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static props:Resources.super_output}"/>
                            <WrapPanel x:Name="super_format_panel">
                                <RadioButton x:Name="super_format_sparse" Style="{StaticResource Segment}" GroupName="super_format" IsChecked="True"
                                             Content="{x:Static props:Resources.super_format_sparse}"/>
                                <RadioButton x:Name="super_format_raw" Style="{StaticResource Segment}" GroupName="super_format"
                                             Content="{x:Static props:Resources.super_format_raw}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,12" Text="{x:Static props:Resources.super_format_note}"/>
                            <CheckBox x:Name="super_verify" IsChecked="True" Margin="0,0,0,14" Content="{x:Static props:Resources.super_verify}"/>

                            <Border x:Name="super_problems_box" Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource DangerLine}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                                <TextBlock x:Name="super_problems" Foreground="{StaticResource Danger}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                            </Border>

                            <Button x:Name="super_build" Style="{StaticResource AccentButton}" MinHeight="40" Margin="0,0,0,8"
                                    Content="{x:Static props:Resources.super_build}"/>
                            <Button x:Name="super_cancel" Style="{StaticResource DangerButton}" Margin="0,0,0,8" Visibility="Collapsed"
                                    Content="{x:Static props:Resources.backup_cancel}"/>
                            <ProgressBar x:Name="super_progress" Height="6" Margin="0,4,0,6"/>
                            <TextBlock x:Name="super_progress_text" FontSize="11" Foreground="{StaticResource Dim}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                            <Button x:Name="super_open_folder" Style="{StaticResource GhostButton}" Margin="0,0,0,14"
                                    Content="{x:Static props:Resources.backup_open_folder}"/>
                            <TextBlock Style="{StaticResource Note}" Text="{x:Static props:Resources.super_flash_note}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem x:Name="samsung_tab" Header="{x:Static props:Resources.nav_samsung}" Tag="{StaticResource IconSamsung}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PageHeader}">
                    <DockPanel LastChildFill="True">
                        <StackPanel x:Name="samsung_header_actions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Style="{StaticResource Chip}" Margin="0,0,10,0" MaxWidth="220">
                                <TextBlock x:Name="samsung_build_chip" FontFamily="{StaticResource Mono}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Button x:Name="samsung_open_other" Margin="0,0,10,0" Content="{x:Static props:Resources.samsung_open}"/>
                            <Button x:Name="samsung_close" Style="{StaticResource GhostButton}" Content="{x:Static props:Resources.payload_remove_file}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static props:Resources.nav_samsung}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static props:Resources.samsung_subtitle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Margin="28,20,28,20">
                    <!-- Nothing open -->
                    <Grid x:Name="samsung_empty" AllowDrop="True" Background="Transparent">
                        <Grid Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle RadiusX="16" RadiusY="16" Stroke="{StaticResource GlassLine2}" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="{StaticResource Glass}"/>
                            <StackPanel HorizontalAlignment="Center" Margin="40,36">
                                <Border Style="{StaticResource EmptyIcon}">
                                    <Path Data="{StaticResource IconSamsung}" Stroke="{StaticResource Accent}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="21"/>
                                </Border>
                                <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{x:Static props:Resources.drop_title}"/>
                                <TextBlock Style="{StaticResource Note}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,14" MaxWidth="440"
                                           Text="{x:Static props:Resources.samsung_drop_detail}"/>
                                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,18" FlowDirection="LeftToRight">
                                    <Border Style="{StaticResource FormatChip}"><TextBlock Text="AP_….tar.md5"/></Border>
                                    <Border Style="{StaticResource FormatChip}"><TextBlock Text="BL"/></Border>
                                    <Border Style="{StaticResource FormatChip}"><TextBlock Text="CP"/></Border>
                                    <Border Style="{StaticResource FormatChip}"><TextBlock Text="CSC"/></Border>
                                    <Border Style="{StaticResource FormatChip}"><TextBlock Text="HOME_CSC"/></Border>
                                    <Border Style="{StaticResource FormatChip}"><TextBlock Text=".lz4"/></Border>
                                </WrapPanel>
                                <Grid HorizontalAlignment="Center">
                                    <StackPanel x:Name="samsung_open_buttons" Orientation="Horizontal">
                                        <Button x:Name="samsung_open" Style="{StaticResource AccentButton}" MinWidth="170" MinHeight="40" Margin="0,0,10,0"
                                                Content="{x:Static props:Resources.samsung_open}"/>
                                        <Button x:Name="samsung_open_folder_pick" MinWidth="150" MinHeight="40"
                                                Content="{x:Static props:Resources.samsung_open_folder}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="samsung_opening" Visibility="Hidden" VerticalAlignment="Center">
                                        <ProgressBar x:Name="samsung_opening_bar" Width="300" Height="6"/>
                                        <TextBlock x:Name="samsung_opening_text" Style="{StaticResource Note}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <!-- Samsung's USB driver, which Download mode needs: installed, or a button to get it. -->
                                <Border Margin="0,24,0,0" Padding="14,8" CornerRadius="10" BorderThickness="1"
                                        Background="{StaticResource Glass2}" BorderBrush="{StaticResource GlassLine}">
                                    <DockPanel>
                                        <TextBlock x:Name="samsung_driver_mark" DockPanel.Dock="Left" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <Button x:Name="samsung_driver_install" DockPanel.Dock="Right" MinHeight="30" Margin="12,0,0,0" Visibility="Collapsed"
                                                Content="{x:Static props:Resources.driver_install}"/>
                                        <TextBlock x:Name="samsung_driver_text" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Text="{x:Static props:Resources.welcome_checking}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Firmware open -->
                    <Grid x:Name="samsung_loaded" Visibility="Collapsed" AllowDrop="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- The firmware's model against the phone's, in one glance. -->
                                <Border x:Name="samsung_match" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,2" Text="{x:Static props:Resources.samsung_info_model}"/>
                                            <TextBlock x:Name="samsung_match_fw" FontWeight="SemiBold" FontSize="14" FlowDirection="LeftToRight" HorizontalAlignment="Left" Text="—"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="samsung_match_mark" Width="30" Height="30" CornerRadius="15" Margin="16,0"
                                                Background="{StaticResource Glass2}" BorderBrush="{StaticResource GlassLine2}" BorderThickness="1" VerticalAlignment="Center">
                                            <Path x:Name="samsung_match_glyph" FlowDirection="LeftToRight" Data="M6,12 H18" Stroke="{StaticResource Faint}" StrokeThickness="2.4"
                                                  Width="14" Height="14" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,2" TextAlignment="Right" Text="{x:Static props:Resources.samsung_match_phone_label}"/>
                                            <TextBlock x:Name="samsung_match_phone" FontWeight="SemiBold" FontSize="14" FlowDirection="LeftToRight" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource Dim}" Text="{x:Static props:Resources.samsung_match_unknown}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,8" Text="{x:Static props:Resources.samsung_files}"/>
                                        <ItemsControl x:Name="samsung_files">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,5">
                                                        <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" Padding="8,2" Margin="0,0,10,0" MinWidth="86" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Part}" FontWeight="SemiBold" FontSize="12" FlowDirection="LeftToRight" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="9,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" FontSize="11.5"/>
                                                        </Border>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Foreground="{StaticResource Dim}" Margin="8,0,0,0" MinWidth="64"
                                                                   TextAlignment="Right" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                                   Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight"
                                                                   VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,8" Text="{x:Static props:Resources.samsung_about}"/>
                                        <ItemsControl x:Name="samsung_info">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,3">
                                                        <TextBlock DockPanel.Dock="Left" Width="140" Text="{Binding Name}" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button x:Name="samsung_read_phone" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,4"
                                                    Content="{x:Static props:Resources.samsung_read_phone}"/>
                                            <TextBlock Style="{StaticResource CardTitle}" VerticalAlignment="Center" TextWrapping="Wrap" Text="{x:Static props:Resources.samsung_match}"/>
                                        </DockPanel>
                                        <Border x:Name="samsung_verdict" CornerRadius="10" BorderThickness="1" Padding="12,10" Margin="0,0,0,8" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock x:Name="samsung_verdict_title" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="samsung_verdict_text" Style="{StaticResource Note}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl x:Name="samsung_findings">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,4">
                                                        <TextBlock DockPanel.Dock="Left" Width="20" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontWeight="Bold"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Faint}" FontSize="11.5" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="samsung_phone_note" Style="{StaticResource Note}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock x:Name="samsung_selected_count" DockPanel.Dock="Right" Foreground="{StaticResource Faint}" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static props:Resources.samsung_contents}"/>
                                </DockPanel>
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button x:Name="samsung_select_boot" Margin="0,0,8,0" Padding="10,4" Content="{x:Static props:Resources.samsung_select_boot}"/>
                                    <Button x:Name="samsung_select_none" Style="{StaticResource GhostButton}" Padding="10,4" Content="{x:Static props:Resources.backup_select_none}"/>
                                </WrapPanel>
                                <ListView x:Name="samsung_entries" SelectionMode="Single" local:ColumnFill.Column="2" local:ColumnFill.MinWidth="110">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Width="34">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Focusable="False"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{x:Static props:Resources.samsung_column_from}" Width="52" DisplayMemberBinding="{Binding Part}"/>
                                            <GridViewColumn Header="{x:Static props:Resources.samsung_column_file}" Width="160">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{x:Static props:Resources.column_size}" Width="76" DisplayMemberBinding="{Binding Size}"/>
                                            <GridViewColumn Width="70">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button x:Name="samsung_change_folder" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,4"
                                            Content="{x:Static props:Resources.backup_change}"/>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionLabel}" Margin="0,0,10,0" VerticalAlignment="Center"
                                               Text="{x:Static props:Resources.backup_save_to}"/>
                                    <TextBlock x:Name="samsung_out_folder" FlowDirection="LeftToRight" FontFamily="{StaticResource Mono}" FontSize="11.5"
                                               Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                </DockPanel>
                                <!-- One main action: a phone in Download mode, its PIT and model read, then the flash checked against them. -->
                                <Button x:Name="samsung_odin" Style="{StaticResource AccentButton}" MinHeight="42" Margin="0,0,0,10"
                                        Content="{x:Static props:Resources.samsung_odin_button}" ToolTip="{x:Static props:Resources.samsung_odin_tip}"/>
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <Button x:Name="samsung_extract" Margin="0,0,4,4" Content="{x:Static props:Resources.samsung_extract}"/>
                                    <Button x:Name="samsung_magisk" Margin="4,0,0,4" Content="{x:Static props:Resources.samsung_magisk}"/>
                                    <Button x:Name="samsung_build_tar" Margin="0,4,4,0" Content="{x:Static props:Resources.samsung_build_tar}"/>
                                    <Button x:Name="samsung_check_patched" Style="{StaticResource GhostButton}" Margin="4,4,0,0" Content="{x:Static props:Resources.samsung_check_patched}"/>
                                </UniformGrid>
                                <Button x:Name="samsung_open_out" Style="{StaticResource GhostButton}" Margin="0,0,0,8"
                                        Content="{x:Static props:Resources.backup_open_folder}"/>
                                <Button x:Name="samsung_super_tools" Style="{StaticResource GhostButton}" Margin="0,0,0,8" Visibility="Collapsed"
                                        Content="{x:Static props:Resources.samsung_super_tools}"/>
                                <Button x:Name="samsung_cancel" Style="{StaticResource DangerButton}" Margin="0,0,0,8" Visibility="Collapsed"
                                        Content="{x:Static props:Resources.backup_cancel}"/>
                                <ProgressBar x:Name="samsung_progress" Height="6" Margin="0,2,0,6"/>
                                <TextBlock x:Name="samsung_progress_text" FontSize="11.5" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                                           ToolTip="{x:Static props:Resources.samsung_note}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Style="{StaticResource NavGroup}" Header="{x:Static props:Resources.nav_group_more}"/>
        <TabItem x:Name="terminal_tab" Header="{x:Static props:Resources.nav_terminal}" Tag="{StaticResource IconTerminal}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PageHeader}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="terminal_folder" Margin="0,0,10,0" Content="{x:Static props:Resources.terminal_folder}"/>
                            <Button x:Name="terminal_clear" Style="{StaticResource GhostButton}" Content="{x:Static props:Resources.logs_clear}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static props:Resources.nav_terminal}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static props:Resources.terminal_subtitle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Margin="28,16,28,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Background="{StaticResource Well}" BorderThickness="1" Padding="14,12">
                        <TextBox FlowDirection="LeftToRight" x:Name="terminal_output" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                 FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Text}"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,12,0,0" FlowDirection="LeftToRight">
                        <Button x:Name="terminal_stop" DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Margin="8,0,0,0" MinWidth="80"
                                IsEnabled="False" Content="{x:Static props:Resources.terminal_stop}"/>
                        <Button x:Name="terminal_run" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Margin="8,0,0,0" MinWidth="80"
                                Content="{x:Static props:Resources.terminal_run}"/>
                        <TextBox x:Name="terminal_input" FontFamily="{StaticResource Mono}" FontSize="13" VerticalContentAlignment="Center" MinHeight="38"/>
                    </DockPanel>

                    <!-- Common commands; a click fills the line, Enter runs it. -->
                    <WrapPanel Grid.Row="2" x:Name="terminal_quick" FlowDirection="LeftToRight" Margin="0,8,0,0"/>

                    <TextBlock Grid.Row="3" x:Name="terminal_folder_text" Style="{StaticResource Note}" FontSize="11.5" Margin="0,4,0,0"
                               FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem x:Name="logs_tab" Header="{x:Static props:Resources.nav_logs}" Tag="{StaticResource IconLogs}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PageHeader}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="log_copy" Margin="0,0,10,0" Content="{x:Static props:Resources.logs_copy}"/>
                            <Button x:Name="log_open_folder" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                    Content="{x:Static props:Resources.logs_open_folder}" ToolTip="{x:Static props:Resources.logs_file_note}"/>
                            <Button x:Name="log_clear" Style="{StaticResource GhostButton}" Content="{x:Static props:Resources.logs_clear}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static props:Resources.nav_logs}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static props:Resources.logs_subtitle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Margin="28,20,28,20" Style="{StaticResource Card}" Background="{StaticResource Well}" BorderThickness="1">
                    <TextBox FlowDirection="LeftToRight" x:Name="log_text" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                             FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Dim}"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </TabItem>
        <!-- Settings and About sit at the foot of the rail (the items host is a DockPanel). -->
        <TabItem x:Name="about_tab" DockPanel.Dock="Bottom" Header="{x:Static props:Resources.about}" Tag="{StaticResource IconAbout}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="28,22,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- The hero: the app, what it does, its version. -->
                    <Border Grid.ColumnSpan="3" Style="{StaticResource Card}" Background="{StaticResource Glass2}" BorderBrush="{StaticResource GlassLine2}" Padding="26,24" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image FlowDirection="LeftToRight" Source="{StaticResource AppIcon}" Width="96" Height="96" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" Margin="22,0,16,0" VerticalAlignment="Center">
                                <Image Source="{StaticResource AppName}" Height="24" HorizontalAlignment="Left" Margin="0,0,0,6" FlowDirection="LeftToRight"
                                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Fastboot Studio"/>
                                <TextBlock Text="{x:Static props:Resources.about_tagline}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Border Style="{StaticResource Chip}" Margin="0,0,6,0"><TextBlock Text="{x:Static local:MainWindow.versionLabel}" FontFamily="{StaticResource Mono}"/></Border>
                                    <Border Style="{StaticResource Chip}" Margin="0,0,6,0"><TextBlock Text="MIT"/></Border>
                                    <Border Style="{StaticResource Chip}"><TextBlock Text="{x:Static props:Resources.about_free}"/></Border>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="about_check_updates" Style="{StaticResource AccentButton}" Margin="0,0,10,0"
                                        Content="{x:Static props:Resources.about_check_updates}"/>
                                <!-- About has no page header, so its ؟ sits in the hero. -->
                                <Button x:Name="about_help" Style="{StaticResource HelpButton}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- The developer and the links. -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="58" Height="58" CornerRadius="16" ClipToBounds="True">
                                    <Image FlowDirection="LeftToRight" Source="Assets/ifoknr-tile.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <Image Source="{StaticResource Signature}" Height="26" HorizontalAlignment="Left" FlowDirection="LeftToRight"
                                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="IFOKNR" ToolTip="IFOKNR"/>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0" Text="{x:Static props:Resources.about_developer}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static props:Resources.about_links}"/>
                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                <Button x:Name="about_telegram" Style="{StaticResource IconButton}" Click="Telegram_Click" Tag="{StaticResource IconSend}"
                                        ToolTip="Telegram · @IFOKNR1" AutomationProperties.Name="Telegram"/>
                                <Button Style="{StaticResource IconButton}" Click="Group_Click" Tag="{StaticResource IconGroup}"
                                        ToolTip="{x:Static props:Resources.about_telegram_group}" AutomationProperties.Name="{x:Static props:Resources.about_telegram_group}"/>
                                <Button x:Name="about_github" Style="{StaticResource IconButton}" Click="GitHub_Click" Tag="{StaticResource IconGitHub}"
                                        ToolTip="GitHub · github.com/ifoknr" AutomationProperties.Name="GitHub"/>
                                <Button Style="{StaticResource IconButton}" Click="Site_Click" Tag="{StaticResource IconGlobe}"
                                        ToolTip="{x:Static props:Resources.about_all_tools}" AutomationProperties.Name="{x:Static props:Resources.about_all_tools}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,10" Text="{x:Static props:Resources.about_built_on}"/>
                                <TextBlock Text="Fastboot Enhance · LibXZR" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,0,0,12" Text="{x:Static props:Resources.about_original_detail}"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource GhostButton}" Margin="0,0,8,6" Content="{x:Static props:Resources.about_original_project}" Click="OSS_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Margin="0,0,8,6" Content="{x:Static props:Resources.visit_thread}" Click="Thread_Click"/>
                                    <Button x:Name="about_license" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Content="{x:Static props:Resources.about_license}" Click="License_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,10" Text="{x:Static props:Resources.about_inside}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Foreground="{StaticResource Dim}" Margin="0,0,12,6" Text="Payload"/>
                                    <TextBlock Grid.Column="1" Margin="0,0,0,6" FlowDirection="LeftToRight" HorizontalAlignment="Left" Text="zstd · xz · bzip2 · SHA-256"/>
                                    <TextBlock Grid.Row="1" Foreground="{StaticResource Dim}" Margin="0,0,12,6" Text="{x:Static props:Resources.about_checks}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" FlowDirection="LeftToRight" HorizontalAlignment="Left" Text="SHA-256 · MD5 · AVB"/>
                                    <TextBlock Grid.Row="2" Foreground="{StaticResource Dim}" Margin="0,0,12,6" Text="{x:Static props:Resources.about_tools}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" FlowDirection="LeftToRight" HorizontalAlignment="Left" Text="platform-tools 37.0.1"/>
                                    <TextBlock Grid.Row="3" Foreground="{StaticResource Dim}" Margin="0,0,12,0" Text="{x:Static props:Resources.nav_samsung}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" FlowDirection="LeftToRight" HorizontalAlignment="Left" Text="Odin protocol v4"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>
        <TabItem x:Name="settings_tab" DockPanel.Dock="Bottom" Header="{x:Static props:Resources.nav_settings}" Tag="{StaticResource IconSettings}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PageHeader}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static props:Resources.nav_settings}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static props:Resources.settings_subtitle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="28,16,28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,12" Text="{x:Static props:Resources.settings_look}"/>
