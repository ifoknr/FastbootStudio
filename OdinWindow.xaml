<Window x:Class="FastbootEnhance.OdinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:FastbootEnhance.Properties"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="700" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <!-- A Samsung phone in Download mode: how to get there, a reading of its PIT and model, then flashing checked against them. -->
    <Border Margin="18" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="strip" Height="3" VerticalAlignment="Top" CornerRadius="11,11,0,0" Background="{StaticResource Accent}"/>

            <DockPanel x:Name="header" Margin="22,20,22,0" Background="Transparent">
                <Border x:Name="badge" DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" BorderThickness="1"
                        Margin="0,0,14,0" VerticalAlignment="Top"
                        Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentLine}">
                    <Path FlowDirection="LeftToRight" x:Name="glyph" Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{StaticResource Accent}"
                          Data="{StaticResource IconSamsung}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="heading" Style="{StaticResource CardTitle}" Margin="0" FontSize="15" TextWrapping="Wrap"
                               Text="{x:Static props:Resources.odin_title}"/>
                    <TextBlock x:Name="subheading" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="{x:Static props:Resources.odin_subtitle}"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="70,14,22,0">
                <!-- Getting the phone into Download mode, and finding it -->
                <StackPanel x:Name="prepare_view">
                    <ItemsControl x:Name="steps" Focusable="False"/>
                    <Border x:Name="maintenance_note" Margin="0,4,0,0" Padding="12,8" CornerRadius="8" BorderThickness="1"
                            Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnLine}">
                        <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Text="{x:Static props:Resources.odin_maintenance}"/>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="14,9" CornerRadius="10" BorderThickness="1"
                            Background="{StaticResource Well}" BorderBrush="{StaticResource Line}">
                        <DockPanel>
                            <TextBlock x:Name="status_mark" DockPanel.Dock="Left" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" Text="…"/>
                            <Button x:Name="driver_button" DockPanel.Dock="Right" MinHeight="30" Margin="12,0,0,0" Visibility="Collapsed"
                                    Content="{x:Static props:Resources.driver_install}"/>
                            <TextBlock x:Name="status_text" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="{x:Static props:Resources.odin_looking}"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Margin="0,14,0,6" FontSize="12.5" FontWeight="SemiBold" Text="{x:Static props:Resources.odin_after_title}"/>
                    <WrapPanel>
                        <RadioButton x:Name="after_android" Style="{StaticResource Segment}" GroupName="odin_after" IsChecked="True"
                                     Content="{x:Static props:Resources.odin_after_android}"/>
                        <RadioButton x:Name="after_download" Style="{StaticResource Segment}" GroupName="odin_after"
                                     Content="{x:Static props:Resources.odin_after_download}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Text="{x:Static props:Resources.odin_after_note}"/>
                </StackPanel>

                <!-- Reading, or a failure -->
                <StackPanel x:Name="work_view" Visibility="Collapsed">
                    <ProgressBar x:Name="progress" Height="6" Margin="0,4,0,8" IsIndeterminate="True" Maximum="100"/>
                    <TextBlock x:Name="progress_text" FontSize="12" Margin="0,0,0,8" Foreground="{StaticResource Dim}" Visibility="Collapsed"/>
                    <TextBlock x:Name="message" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"/>
                </StackPanel>

                <!-- What was read -->
                <StackPanel x:Name="result_view" Visibility="Collapsed">
                    <Grid x:Name="facts">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <TextBlock x:Name="info_note" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>

                    <Border Margin="0,12,0,0" CornerRadius="10" BorderThickness="1" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}">
                        <DockPanel>
                            <Grid x:Name="pit_head" DockPanel.Dock="Top" Margin="12,8,12,6"/>
                            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Line}"/>
                            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="pit_rows" Margin="12,4,12,6"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="pit_save" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Content="{x:Static props:Resources.odin_save_pit}"/>
                    </WrapPanel>
                    <TextBlock x:Name="end_note" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Flashing: the files, what they go to, the checks -->
                <StackPanel x:Name="plan_view" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Text="{x:Static props:Resources.odin_flash_intro}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="flash_choose" Style="{StaticResource GhostButton}" Content="{x:Static props:Resources.odin_flash_choose}"/>
                        <TextBlock x:Name="plan_total" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12.5" Foreground="{StaticResource Dim}"/>
                    </StackPanel>
                    <StackPanel x:Name="plan_reading" Margin="0,10,0,0" Visibility="Collapsed">
                        <ProgressBar x:Name="plan_progress" Height="6" Maximum="100"/>
                        <TextBlock x:Name="plan_reading_text" FontSize="12" Margin="0,6,0,0" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border x:Name="plan_box" Margin="0,10,0,0" CornerRadius="10" BorderThickness="1" Visibility="Collapsed"
                            Background="{StaticResource Well}" BorderBrush="{StaticResource Line}">
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="plan_rows" Margin="12,6,12,6"/>
                        </ScrollViewer>
                    </Border>
                    <StackPanel x:Name="plan_targets" Margin="0,8,0,0"/>
                    <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                        <StackPanel x:Name="plan_checks"/>
                    </ScrollViewer>
                    <CheckBox x:Name="plan_ack" Margin="0,8,0,0" Visibility="Collapsed" Content="{x:Static props:Resources.odin_flash_ack}"/>
                    <CheckBox x:Name="plan_restart" Margin="0,8,0,0" IsChecked="True" Content="{x:Static props:Resources.odin_flash_restart}"/>

                    <Border Margin="0,12,0,0" Padding="14,9" CornerRadius="10" BorderThickness="1"
                            Background="{StaticResource Well}" BorderBrush="{StaticResource Line}">
                        <DockPanel>
                            <TextBlock x:Name="flash_status_mark" DockPanel.Dock="Left" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" Text="…"/>
                            <TextBlock x:Name="flash_status_text" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="{x:Static props:Resources.odin_flash_waiting}"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Margin="0,18,0,0" Padding="22,14" Background="{StaticResource Bg}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11">
                <DockPanel>
                    <Button x:Name="extra" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" MinWidth="96" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="secondary" MinWidth="96" Margin="0,0,10,0"/>
                        <Button x:Name="primary" MinWidth="130" Style="{StaticResource AccentButton}" IsDefault="True"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
